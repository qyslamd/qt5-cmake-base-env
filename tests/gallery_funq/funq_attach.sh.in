#!/bin/sh
# funq 的「注入器」入口（Linux 侧，对应同目录的 funq_attach.bat.in）。
#
# funq 客户端会把被测程序交给它启动，由它把 libFunq.so 注入进去——Linux 走
# LD_PRELOAD（见 funq_server/runner_linux.py），Windows 走 CreateRemoteThread。
#
# 为什么需要这个包装：客户端构造的命令是 [attach_exe] + [被测程序] + 参数
# （见 funq/client.py 的 _start_test_process），所以 attach_exe 必须是一个
# 「吃下后续参数并转交给 funq runner」的可执行文件——python3 直接当
# attach_exe 用是不行的（它会把被测程序当成脚本名）。
#
# exec 而非另起子进程：让 python 直接顶替本 shell，消息号与退出码都能原样
# 传回去，funq 清理时杀的也就是它。
#
# 本文件由 CMake 生成到 build 下，不入库。
#
# --library 显式指定本构建目录对应的那份注入库：暂存目录在源码树里、只有一个，
# 多个配置的构建会互相覆盖；不指定就成了"谁最后构建谁说了算"，而库与被测程序
# 配置不一致时只会报一句看不出原因的话

PYTHONPATH="@FUNQ_CLIENT_DIR@:@FUNQ_SERVER_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "@PYTHON_EXECUTABLE@" -m funq_server.runner --library "@FUNQ_INJECTOR_LIBRARY@" "$@"
