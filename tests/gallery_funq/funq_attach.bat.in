@echo off
rem funq "injector" entry point: the funq client hands the tested program to
rem this script, which starts it with libFunq.dll injected (see
rem funq_server/runner.py and runner_win.py).
rem
rem Why the wrapper is needed: the client builds the command as
rem [attach_exe] + [tested program] + args (see client.py's
rem _start_test_process), so attach_exe must be an executable that swallows
rem the remaining arguments and forwards them to the funq runner. Using
rem python.exe directly does not work - it would treat the tested program as
rem the script name.
rem
rem Generated by CMake into <build>/bin, not tracked in git.
rem
rem --library names the injector built for THIS build directory: the staging
rem directory lives in the source tree and is shared by every configuration,
rem so without it "whichever build came last" wins - and a library whose
rem configuration differs from the tested program only reports a message that
rem does not explain itself

set "PYTHONPATH=@FUNQ_CLIENT_DIR@;@FUNQ_SERVER_DIR@;%PYTHONPATH%"
"@PYTHON_EXECUTABLE@" -m funq_server.runner --library "@FUNQ_INJECTOR_LIBRARY@" %*
