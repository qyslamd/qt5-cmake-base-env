#!/bin/sh
# funq "injector" entry point (Linux side, mirrors funq_attach.bat.in).
#
# The funq client hands the tested program to this script, which starts it
# with libFunq.so injected - Linux goes through LD_PRELOAD (see
# funq_server/runner_linux.py), Windows through CreateRemoteThread.
#
# Why the wrapper is needed: the client builds the command as
# [attach_exe] + [tested program] + args (see client.py's
# _start_test_process), so attach_exe must be an executable that swallows
# the remaining arguments and forwards them to the funq runner. Using
# python3 directly does not work - it would treat the tested program as
# the script name.
#
# exec rather than spawning a child: this lets python replace the shell, so
# signals and the exit code pass through unchanged and funq kills python
# itself when it cleans up.
#
# Generated by CMake into <build>/bin, not tracked in git.
#
# --library names the injector built for THIS build directory: the staging
# directory lives in the source tree and is shared by every configuration,
# so without it "whichever build came last" wins - and a library whose
# configuration differs from the tested program only reports a message that
# does not explain itself

PYTHONPATH="@FUNQ_CLIENT_DIR@:@FUNQ_SERVER_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "@PYTHON_EXECUTABLE@" -m funq_server.runner --library "@FUNQ_INJECTOR_LIBRARY@" "$@"
