# funq 的应用配置：告诉 funq 要拉起哪个程序、在哪个目录、用哪个端口。
# 由 CMake 按本机构建目录生成到 build 下（见同目录 CMakeLists.txt），不入库。
#
# 与 tests/funq_demo 那份的分工：那边靶子是 examples/funq_target（为测试造的
# 示例），这里靶子就是**本仓真程序** demo_app——启动顺序、登录、单实例这些
# 真程序才有的东西，只有拿真程序当靶子才验得到。
#
# funq_port = 0 表示由 funq 自己挑一个空闲端口。

[demo_app]
executable = @TARGET_EXE@
cwd = @TARGET_DIR@
funq_port = 0
aliases = @TARGET_ALIAS@
args = --set crash/backend=none --set login/enabled=false
# args 用 --set 注入两个配置覆盖（funq 按 shlex.split 拆分，值不带空格无需
# 引号），都只对本次运行生效、不落盘：
#   login/enabled=false  登录框不出现，MainWindow 启动即建——用例不必先过登录，
#                        也免去首登强制改密对 users.json 的副作用
#   crash/backend=none   启动不装崩溃后端，待处理的崩溃报告恒按"没有报告"
#                        处理，MaybePromptCrashReport 的模态框就不会出现——
#                        不加这条，%LOCALAPPDATA% 下攒着报告时用例会卡在那个
#                        框上，报出来的却是"找不到 MainWindow"（踩过的坑）
# 要演练登录流程本身，把这两条删掉即可：funq_app_case.py 的 ensure_logged_in
# 是兜底，探到登录框仍会照常登进去。
executable_stdout = NULL
executable_stderr = NULL
screenshot_on_error = 0
