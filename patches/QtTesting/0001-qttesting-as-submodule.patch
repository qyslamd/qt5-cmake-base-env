+    OUTPUT_NAME ${QT_TESTING_CUSTOM_LIBRARY_PREFIX}qttesting${QT_TESTING_CUSTOM_LIBRARY_SUFFIX}
+    )
 
   TARGET_LINK_LIBRARIES(qttesting PRIVATE
     ${qt_imported_targets}
