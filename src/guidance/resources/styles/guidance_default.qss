/* ==================== 新手引导（3.8 色板，浅色） ==================== */
QWidget#guidanceHomeClose {
    color: #8A8A8A;
    font-size: 16px;
}
QWidget#guidanceHomePanel {
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 12px;
}
QLabel#guidanceHomeTitle {
    color: #1F1F1F;
    font-size: 20px;
    font-weight: 600;
}
QLabel#guidanceHomeSub {
    color: #6E6E6E;
    font-size: 13px;
}
/* 卡片：底色/边框/圆角是本体，hover 走伪状态，选中与占位走动态属性。
   这几条是卡片外观的**唯一出处**——自绘那套已删（它原先无条件画在 QSS
   之后，把这里的规则盖住了）。顺序有意义：同等特异性下靠后的赢，
   所以 :hover → [placeholder] → [selected] 由弱到强 */
QWidget#guidanceCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}
QWidget#guidanceCard:hover {
    background-color: #E0E0E0;
}
QWidget#guidanceCard[placeholder="true"] {
    border: 1px solid #AAAAAA;
}
QWidget#guidanceCard[selected="true"] {
    background-color: #CCE4F7;
    border: 2px solid #007ACC;
}
QLabel#guidanceCardTitle {
    color: #333333;
    font-size: 13px;
    font-weight: 600;
}
QLabel#guidanceCardDesc {
    color: #8A8A8A;
    font-size: 11px;
}
QLabel#bubble_title {
    color: #333333;
    font-size: 14px;
    font-weight: 600;
}
QLabel#bubble_text {
    color: #333333;
    font-size: 12px;
}
QLabel#bubble_countdown {
    color: #8A8A8A;
    font-size: 11px;
}
QPushButton#bubble_skip {
    color: #0078D4;
    background: transparent;
    border: none;
    font-size: 12px;
}
QPushButton#bubble_prev {
    border: 1px solid #D0D0D0;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    color: #333333;
    background-color: #FFFFFF;
}
QPushButton#bubble_next {
    border: 1px solid #0078D4;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    color: #FFFFFF;
    background-color: #0078D4;
}