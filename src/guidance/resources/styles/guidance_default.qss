/* ==================== 新手引导（3.8 色板，浅色） ==================== */
QWidget#guidanceHomeClose {
    color: #8A8A8A;
    font-size: 16px;
}
QWidget#guidanceHomePanel {
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 12px;
}
QLabel#guidanceHomeTitle {
    color: #1F1F1F;
    font-size: 20px;
    font-weight: 600;
}
QLabel#guidanceHomeSub {
    color: #6E6E6E;
    font-size: 13px;
}
QWidget#guidanceCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}
QLabel#guidanceCardTitle {
    color: #333333;
    font-size: 13px;
    font-weight: 600;
}
QLabel#guidanceCardDesc {
    color: #8A8A8A;
    font-size: 11px;
}
QLabel#bubble_title {
    color: #333333;
    font-size: 14px;
    font-weight: 600;
}
QLabel#bubble_text {
    color: #333333;
    font-size: 12px;
}
QLabel#bubble_countdown {
    color: #8A8A8A;
    font-size: 11px;
}
QPushButton#bubble_skip {
    color: #0078D4;
    background: transparent;
    border: none;
    font-size: 12px;
}
QPushButton#bubble_prev {
    border: 1px solid #D0D0D0;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    color: #333333;
    background-color: #FFFFFF;
}
QPushButton#bubble_next {
    border: 1px solid #0078D4;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    color: #FFFFFF;
    background-color: #0078D4;
}