/* 底座层 09 / 10 · 进度与滑块 */

QProgressBar {
  background-color: #E0E0E0;
  color: #666666;
  border: none;
  border-radius: 4px;
  height: 16px;
  font-size: 11px;
  /* QSS 未声明 text-align 时默认左对齐，显式居中 */
  text-align: center;
}
QProgressBar::chunk {
  background-color: #0078D4;
  border-radius: 4px;
}
QProgressBar:disabled {
  color: #AAAAAA;
}
QProgressBar::chunk:disabled {
  background-color: #C0C0C0;
}

QSlider::groove:horizontal {
  background: #E0E0E0;
  height: 4px;
  border-radius: 2px;
}
QSlider::sub-page:horizontal {
  background: #0078D4;
  border-radius: 2px;
}
QSlider::handle:horizontal {
  background: #FFFFFF;
  border: 2px solid #0078D4;
  width: 12px;
  height: 12px;
  margin: -6px 0;
  border-radius: 8px;
}
QSlider::handle:horizontal:hover {
  border-color: #1A86E0;
}
QSlider::groove:vertical {
  background: #E0E0E0;
  width: 4px;
  border-radius: 2px;
}
QSlider::add-page:vertical {
  background: #0078D4;
  border-radius: 2px;
}
QSlider::handle:vertical {
  background: #FFFFFF;
  border: 2px solid #0078D4;
  width: 12px;
  height: 12px;
  margin: 0 -6px;
  border-radius: 8px;
}
QSlider::handle:vertical:hover {
  border-color: #1A86E0;
}
