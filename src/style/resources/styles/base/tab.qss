/* 底座层 06 / 10 · 选项卡：狠人版 */

QTabWidget::pane {
  background-color: #FFFFFF;
  border: none; 
  border-top: 1px solid #D0D0D0; 
  top: -1px; /* 提上去吃掉缝 */
}

QTabWidget::tab-bar {
  alignment: left;
}

QTabBar {
  background: #DEE1E6; 
  qproperty-drawBase: 0;
  padding-top: 4px; /* 留一点点顶部呼吸感 */
}

/* 没选中的：灰底，矮一截，老老实实待着 */
QTabBar::tab {
  background: #DEE1E6;
  color: #4A4A4A;
  border: 1px solid transparent; 
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  padding: 6px 16px; /* 高度矮一点 */
  margin-right: 0px; 
  margin-top: 4px;   /* 沉下去 */
  min-width: 80px;
}

/* Hover：直接原地拔高，跟选中一样！ */
QTabBar::tab:hover {
  background: #FFFFFF;
  color: #0078D4;
  border: 1px solid #D0D0D0;
  border-bottom: none; 
  margin-top: 0px;   /* 拔高！不悬空了！ */
  padding-top: 10px; /* 补齐拔高后的内边距 */
  padding-bottom: 7px;
}

/* 选中：稳稳焊死 */
QTabBar::tab:selected {
  background: #FFFFFF;
  color: #0078D4; 
  border: 1px solid #D0D0D0;
  border-bottom: none; 
  margin-top: 0px;     
  padding-top: 10px;   
  padding-bottom: 7px;
  font-weight: bold; /* 给老大加个粗，拉开和hover的区别 */
}
