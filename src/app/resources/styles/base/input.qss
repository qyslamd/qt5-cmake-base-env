/* 底座层 03 / 10 · 输入族
 *
 * role="form" 是表单里的输入框变体（浅底、细边框），本仓登录与改密对话框用它。
 * 错误态用动态属性 [error="true"]（本仓既有约定），运行中改属性要
 * unpolish + polish。
 */

/* QLineEdit */
QLineEdit {
  background-color: rgba(255, 255, 255, 0.85);
  border: 1.5px solid #D0D0DD;
  border-radius: 8px;
  padding: 4px 12px;
  color: #333333;
  selection-background-color: #007ACC;
  selection-color: #FFFFFF;
}
QLineEdit:focus {
  border-color: #007ACC;
  background-color: #FFFFFF;
}
QLineEdit:disabled {
  background-color: #F0F0F0;
  color: #AAAAAA;
  border-color: #E0E0E0;
}
QLineEdit[error="true"] {
  border: 1.5px solid #D13438;
}
QLineEdit[role="form"] {
  background: #F5F5F5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
}
QLineEdit[role="form"]:focus {
  border-color: #1D8FE1;
  background: #FFFFFF;
}

/* QTextEdit / QPlainTextEdit */
QTextEdit, QPlainTextEdit {
  background-color: rgba(255, 255, 255, 0.85);
  border: none;
  border-radius: 10px;
  padding: 8px 10px;
  color: #333333;
  selection-background-color: #007ACC;
  selection-color: #FFFFFF;
}
QTextEdit:focus, QPlainTextEdit:focus {
  border: 1px solid #007ACC;
}
QTextEdit[error="true"], QPlainTextEdit[error="true"] {
  border: 1.5px solid #D13438;
}

/* 微调框族：QAbstractSpinBox 覆盖 QSpinBox / QDoubleSpinBox / QDateEdit /
   QTimeEdit / QDateTimeEdit */
QAbstractSpinBox {
  background: #F0F0F0;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 8px 30px 8px 12px;
  color: #333333;
  font-size: 13px;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
  min-height: 20px;
}
QAbstractSpinBox:hover {
  background: #F1F1F1;
  border: 1px solid #007ACC;
}
QAbstractSpinBox:focus {
  border: 2px solid #007ACC;
}
QAbstractSpinBox:disabled {
  background: #F0F0F0;
  color: #AAAAAA;
  border: 1px solid #CCCCCC;
}
QAbstractSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: right top;
  width: 28px;
  height: 14px;
  border: none;
  border-top-right-radius: 7px;
  border-left: 1px solid #CCCCCC;
  background: transparent;
}
QAbstractSpinBox::up-button:hover {
  background: rgba(0, 122, 204, 0.2);
}
QAbstractSpinBox::up-button:pressed {
  background: rgba(0, 122, 204, 0.4);
}
QAbstractSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: right bottom;
  width: 28px;
  height: 14px;
  border: none;
  border-bottom-right-radius: 7px;
  border-left: 1px solid #CCCCCC;
  background: transparent;
}
QAbstractSpinBox::down-button:hover {
  background: rgba(0, 122, 204, 0.2);
}
QAbstractSpinBox::down-button:pressed {
  background: rgba(0, 122, 204, 0.4);
}
/* 上下箭头沿用 Qt 原生绘制：换成自绘需要额外备两套箭头 SVG，
   不在本次范围内 */
QAbstractSpinBox::up-arrow {
  width: 12px;
  height: 12px;
}
QAbstractSpinBox::down-arrow {
  width: 12px;
  height: 12px;
}
/* 日历下拉按钮（QDateEdit / QDateTimeEdit 开 calendarPopup 时） */
QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {
  subcontrol-origin: border;
  subcontrol-position: center right;
  width: 24px;
  border: none;
  background: transparent;
}

/* QComboBox */
QComboBox {
  background: #F0F0F0;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 8px 36px 8px 8px;
  color: #333333;
  font-size: 13px;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
  min-height: 20px;
}
QComboBox:hover {
  border: 1px solid #007ACC;
  background: #F1F1F1;
}
QComboBox:focus {
  border: 2px solid #007ACC;
  background: #F1F1F1;
}
QComboBox:disabled {
  background: #F0F0F0;
  color: #AAAAAA;
  border: 1px solid #CCCCCC;
}
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 32px;
  height: 100%;
  border: none;
  border-left: 1px solid #CCCCCC;
  border-top-right-radius: 7px;
  border-bottom-right-radius: 7px;
  background: transparent;
}
QComboBox::drop-down:hover {
  background: rgba(0, 122, 204, 0.2);
}
QComboBox::drop-down:pressed {
  background: rgba(0, 122, 204, 0.4);
}
QComboBox::drop-down:disabled {
  background: #F0F0F0;
  border-left: 1px solid #CCCCCC;
}
/* 下拉箭头沿用 Qt 原生绘制：换自绘需要额外备箭头 SVG，不在本次范围内 */
QComboBox::down-arrow {
  subcontrol-origin: margin;
  subcontrol-position: right center;
}
QComboBox::down-arrow:disabled {
  opacity: 0.5;
}

/* 下拉弹出列表：它会命中 itemview.qss 的 QAbstractItemView 规则，这里的
   后代选择器具体度更高，把外观收回到下拉框自己的样子 */
QComboBox QAbstractItemView {
  background: #F0F0F0;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 4px;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
  outline: none;
  alternate-background-color: transparent;
  color: #333333;
}
QComboBox QAbstractItemView::item {
  padding: 10px 14px;
  margin: 2px 4px;
  border-radius: 6px;
  min-height: 24px;
  color: #333333;
}
QComboBox QAbstractItemView::item:hover {
  background: rgba(0, 122, 204, 0.3);
  color: #333333;
}
QComboBox QAbstractItemView::item:selected {
  background: rgba(0, 122, 204, 0.6);
  color: #FFFFFF;
  border: 1px solid rgba(0, 122, 204, 0.8);
}
QComboBox QAbstractItemView::item:alternate {
  background: transparent;
}
