/* 底座层 07 / 10 · 容器
 *
 * 不给 QFrame 加规则：SARibbonPanel、SARibbonGallery 都是 QFrame 的子类，
 * 一条裸 QFrame 规则会直接改功能区的面板外观。需要背景/边框的块请在自己
 * 那里声明（本仓的做法是给块本身设 objectName，见项目层）。
 */

QGroupBox {
  background-color: #FAFAFA;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  margin-top: 0px;
  padding: 22px 12px 12px 12px;
  color: #333333;
}
QGroupBox::title {
  subcontrol-origin: padding;
  subcontrol-position: top left;
  left: 12px;
  top: 8px;
  padding: 0 4px;
  color: #888888;
  font-size: 12px;
  font-weight: 700;
}
QGroupBox:hover {
  border: 1px solid #007ACC;
}
QGroupBox:disabled {
  color: #AAAAAA;
}

QScrollArea {
  border: none;
  background: transparent;
}
QScrollArea > QWidget {
  background-color: transparent;
}

/* 分割器：handle 的尺寸必须按方向分别写，只写 QSplitter::handle 是无效的 */
QSplitter {
  border: none;
  background-color: transparent;
}
QSplitter::handle {
  background-color: transparent;
  border: none;
  image: none;
}
QSplitter::handle:hover {
  background-color: #007ACC;
}
QSplitter::handle:pressed {
  background-color: #0078D4;
}
QSplitter::handle:horizontal {
  background-color: transparent;
  border: none;
  image: none;
  width: 6px;
}
QSplitter::handle:horizontal:hover {
  background-color: #007ACC;
}
QSplitter::handle:horizontal:pressed {
  background-color: #0078D4;
}
QSplitter::handle:vertical {
  background-color: transparent;
  border: none;
  image: none;
  height: 6px;
}
QSplitter::handle:vertical:hover {
  background-color: #007ACC;
}
QSplitter::handle:vertical:pressed {
  background-color: #0078D4;
}
