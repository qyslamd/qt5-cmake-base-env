/* 底座层 02 / 10 · 按钮族
 *
 * 类型选择器带继承语义：QPushButton / QToolButton 的规则对其全部子类生效
 * （功能区里的 SARibbonToolButton、SARibbonApplicationButton 也是
 * QToolButton 的子类）。它们的主题在冲突的属性上优先，本层只在主题没声明的
 * 属性上生效——所以动这里的 QToolButton 规则要看功能区。
 *
 * 角色用动态属性表达（不用 objectName，那留给 funq 的控件路径与 QtTesting
 * 录制）：role="primary" 主按钮、role="secondary" 次按钮、role="danger" 危险。
 * 属性在控件构造时设好即可；运行中改属性要 unpolish + polish 才会重刷。
 */

/* QPushButton 默认按主按钮给（本仓原有样式表就是这么用的） */
QPushButton {
  background-color: #0078D4;
  color: #FFFFFF;
  border: 1px solid #0078D4;
  border-radius: 3px;
  padding: 5px 16px;
}
QPushButton:hover {
  background-color: #1A86E0;
}
QPushButton:pressed {
  background-color: #006ABF;
}
QPushButton:disabled {
  background-color: #E0E0E0;
  color: #AAAAAA;
  border-color: #D0D0D0;
}

QPushButton[role="secondary"] {
  background-color: #FFFFFF;
  color: #333333;
  border: 1px solid #CCCCCC;
}
QPushButton[role="secondary"]:hover {
  background-color: #F5F6FA;
  border-color: #007ACC;
}
QPushButton[role="secondary"]:pressed {
  background-color: #E8EAF6;
}
QPushButton[role="secondary"]:disabled {
  background-color: #F0F0F0;
  color: #AAAAAA;
  border-color: #E0E0E0;
}

QPushButton[role="danger"] {
  background-color: #D13438;
  border-color: #D13438;
}
QPushButton[role="danger"]:hover {
  background-color: #DD4448;
}
QPushButton[role="danger"]:pressed {
  background-color: #BE2F33;
}

/* QToolButton 默认中性：它在工具条、面板标题、功能区旁边都用得上 */
QToolButton {
  background: transparent;
  color: #333333;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 3px 6px;
}
QToolButton:hover {
  background-color: #EAEAEA;
}
QToolButton:pressed {
  background-color: #DDDDDD;
}
QToolButton:checked {
  background-color: #DCE9F7;
  border-color: #BBD4EE;
}
QToolButton:disabled {
  color: #AAAAAA;
}
QToolButton[role="primary"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #4080ff, stop:1 #80c0ff);
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
}
QToolButton[role="primary"]:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #3070ee, stop:1 #70b0ff);
}
QToolButton[role="primary"]:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #2060dd, stop:1 #60a0ee);
}
QToolButton[role="danger"] {
  color: #D13438;
}
QToolButton[role="danger"]:hover {
  background-color: #FAE3E4;
}

/* QCheckBox / QRadioButton */
QCheckBox, QRadioButton {
  color: #333333;
  spacing: 6px;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #CCCCCC;
  border-radius: 3px;
  background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
  border-color: #007ACC;
}
QCheckBox::indicator:checked {
  background-color: #0078D4;
  border-color: #0078D4;
  image: url(:/resources/icons/svg/check.svg);
}
QCheckBox::indicator:checked:hover {
  background-color: #1A86E0;
  border-color: #1A86E0;
}
QCheckBox::indicator:disabled {
  background-color: #F0F0F0;
  border-color: #E0E0E0;
}
QRadioButton::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  background-color: #FFFFFF;
}
QRadioButton::indicator:hover {
  border-color: #007ACC;
}
QRadioButton::indicator:checked {
  background-color: #0078D4;
  border-color: #0078D4;
  image: url(:/resources/icons/svg/radio_dot.svg);
}
QRadioButton::indicator:disabled {
  background-color: #F0F0F0;
  border-color: #E0E0E0;
}

/* 对话框按钮盒：按钮给个统一的最小宽度，免得长短不一 */
QDialogButtonBox QPushButton {
  min-width: 80px;
}
