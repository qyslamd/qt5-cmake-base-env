/* 底座层 06 / 10 · 选项卡 */

QTabWidget::pane {
  border: none;
}

QTabWidget::tab-bar {
  alignment: left;
}

QTabBar {
  background: #F5F6FA;
  qproperty-drawBase: 0;
}

/* tab 的形状由 TabBarStyle（QProxyStyle）自绘：QSS 与 QProxyStyle 会互相打架
   （一个走样式表绘制、一个走 style 的 drawControl），所以这里只声明颜色类
   属性，尺寸与圆角交给代理样式 */
QTabBar::tab {
  background: transparent;
  color: #666666;
  padding: 6px 14px;
  border: none;
}
QTabBar::tab:hover {
  color: #1F1F1F;
}
QTabBar::tab:selected {
  color: #0078D4;
}

QTabBar::close-button {
  subcontrol-position: right;
}
