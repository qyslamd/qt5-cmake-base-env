* {
  font-family: "Microsoft YaHei";
}

/* ========== 通用控件基础样式 ========== */
/* 仅保留与具体业务无关的控件族样式，来自 ETestStudio 的通用部分。
   业务专属选择器（#topology*、#welcome*、#userMgr* 等）一律未纳入。 */

/* ---------- QTreeView ---------- */
QTreeView {
  border: none;
}

/* ---------- QListView ---------- */
QListView {
  background-color: #FFFFFF;
  color: #1F1F1F;
  border: none;
  outline: none;
  selection-background-color: #CCE4F7;
  selection-color: #1F1F1F;
}
QListView::item {
  padding: 5px 8px;
  border: none;
  border-radius: 6px;
}
QListView::item:hover {
  background-color: #EAEAEA;
}
QListView::item:selected {
  background-color: rgba(0, 103, 192, 0.10);
}

/* ---------- QLineEdit ---------- */
QLineEdit {
  background-color: rgba(255, 255, 255, 0.85);
  border: 1.5px solid #D0D0DD;
  border-radius: 8px;
  padding: 4px 12px;
  color: #333333;
  selection-background-color: #007ACC;
}
QLineEdit:focus {
  border-color: #007ACC;
  background-color: #FFFFFF;
}
QLineEdit[error="true"] {
  border: 1.5px solid #D13438;
}

/* ---------- QTextEdit ---------- */
QTextEdit {
  background-color: rgba(255, 255, 255, 0.85);
  border: none;
  border-radius: 10px;
  padding: 8px 10px;
  color: #333333;
  selection-background-color: #007ACC;
}
QTextEdit:focus {
  border: 1px solid #007ACC;
}
QTextEdit[error="true"] {
  border: 1.5px solid #D13438;
}

/* ---------- QScrollBar ---------- */
QScrollBar:vertical {
  background-color: #F0F0F0;
  width: 10px;
  margin: 0px;
}
QScrollBar::handle:vertical {
  background-color: #C0C0C0;
  min-height: 30px;
  border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
  background-color: #A0A0A0;
}
QScrollBar::handle:vertical:pressed {
  background-color: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}
QScrollBar:horizontal {
  background-color: #F0F0F0;
  height: 10px;
  margin: 0px;
}
QScrollBar::handle:horizontal {
  background-color: #C0C0C0;
  min-width: 30px;
  border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
  background-color: #A0A0A0;
}
QScrollBar::handle:horizontal:pressed {
  background-color: #909090;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

/* ---------- QSplitter ---------- */
QSplitter {
  border: none;
  background-color: transparent;
}
QSplitter::handle {
  background-color: transparent;
  border: none;
  image: none;
}
QSplitter::handle:hover {
  background-color: #0055aa;
}
QSplitter::handle:pressed {
  background-color: #0055aa;
}
QSplitter::handle:horizontal {
  background-color: transparent;
  border: none;
  image: none;
  width: 6px;
}
QSplitter::handle:horizontal:hover {
  background-color: #0055aa;
}
QSplitter::handle:horizontal:pressed {
  background-color: #0055aa;
}
QSplitter::handle:vertical {
  background-color: transparent;
  border: none;
  image: none;
  height: 6px;
}
QSplitter::handle:vertical:hover {
  background-color: #0055aa;
}
QSplitter::handle:vertical:pressed {
  background-color: #0055aa;
}

/* ---------- QScrollArea ---------- */
QScrollArea {
  border: none;
  background: transparent;
}
QScrollArea > QWidget {
  background-color: transparent;
}

/* ---------- QGraphicsView ---------- */
QGraphicsView {
  background: transparent;
  border: 1px solid #E0E0E0;
  border-bottom: none;
  border-radius: 8px;
}

/* ---------- QMainWindow 分隔条 ---------- */
QMainWindow::separator {
  background-color: transparent;
  width: 6px;
  height: 6px;
  border: none;
}
QMainWindow::separator:hover {
  background-color: #0055aa;
}
QMainWindow::separator:pressed {
  background-color: #0055aa;
}

/* ---------- QPushButton ---------- */
QPushButton {
  background-color: #0078D4;
  color: #FFFFFF;
  border: 1px solid #0078D4;
  border-radius: 3px;
  padding: 5px 16px;
}
QPushButton:hover {
  background-color: #1A86E0;
}
QPushButton:pressed {
  background-color: #006ABF;
}
QPushButton:disabled {
  background-color: #E0E0E0;
  color: #AAAAAA;
  border-color: #D0D0D0;
}

/* ---------- QComboBox ---------- */
QComboBox {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #F0F0F0, stop:1 #F0F0F0);
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 8px 36px 8px 8px;
  color: #333333;
  font-size: 13px;
  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
  min-height: 20px;
}
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 32px;
  height: 100%;
  border: none;
  border-left: 1px solid #CCCCCC;
  border-top-right-radius: 7px;
  border-bottom-right-radius: 7px;
  background: transparent;
}
QComboBox::drop-down:hover {
  background: rgba(0, 122, 204, 0.2);
}
QComboBox::drop-down:pressed {
  background: rgba(0, 122, 204, 0.4);
}
/* 下拉箭头沿用 Qt 原生绘制：参考实现的 image 依赖其自有 SVG 资源，
   引入需额外链接 Qt5::Svg 并部署 qsvg 插件，不在本次范围内 */
QComboBox::drop-down::down-arrow {
  subcontrol-origin: margin;
  subcontrol-position: right center;
}
QComboBox QAbstractItemView {
  background: #F0F0F0;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 4px;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
  outline: none;
  alternate-background-color: transparent;
  color: #333333;
}
QComboBox QAbstractItemView::item {
  padding: 10px 14px;
  margin: 2px 4px;
  border-radius: 6px;
  min-height: 24px;
  color: #333333;
}
QComboBox QAbstractItemView::item:hover {
  background: rgba(0, 122, 204, 0.3);
  color: #333333;
}
QComboBox QAbstractItemView::item:selected {
  background: rgba(0, 122, 204, 0.6);
  color: #FFFFFF;
  border: 1px solid rgba(0, 122, 204, 0.8);
}
QComboBox QAbstractItemView::item:alternate {
  background: transparent;
}
QComboBox:hover {
  border: 1px solid #007ACC;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #F1F1F1, stop:1 #F1F1F1);
}
QComboBox:focus {
  border: 2px solid #007ACC;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #F1F1F1, stop:1 #F1F1F1);
}
QComboBox:disabled {
  background: #F0F0F0;
  color: #AAAAAA;
  border: 1px solid #CCCCCC;
}
QComboBox::drop-down:disabled {
  background: #F0F0F0;
  border-left: 1px solid #CCCCCC;
}
QComboBox::down-arrow:disabled {
  opacity: 0.5;
}

/* ---------- QSpinBox / QDoubleSpinBox ---------- */
QSpinBox, QDoubleSpinBox {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #F0F0F0, stop:1 #F0F0F0);
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  padding: 8px 30px 8px 12px;
  color: #333333;
  font-size: 13px;
  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
  selection-background-color: #CCE4F7;
  selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #F1F1F1, stop:1 #F1F1F1);
  border: 1px solid #007ACC;
}
QSpinBox:focus, QDoubleSpinBox:focus {
  border: 2px solid #007ACC;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
  background: #F0F0F0;
  color: #AAAAAA;
  border: 1px solid #CCCCCC;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: right top;
  width: 28px;
  height: 14px;
  border: none;
  border-top-right-radius: 7px;
  border-left: 1px solid #CCCCCC;
  background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
  background: rgba(0, 122, 204, 0.2);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
  background: rgba(0, 122, 204, 0.4);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: right bottom;
  width: 28px;
  height: 14px;
  border: none;
  border-bottom-right-radius: 7px;
  border-left: 1px solid #CCCCCC;
  background: transparent;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
  background: rgba(0, 122, 204, 0.2);
}
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
  background: rgba(0, 122, 204, 0.4);
}
/* 上下箭头同样沿用 Qt 原生绘制，原因见 QComboBox::down-arrow */
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  width: 12px;
  height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  width: 12px;
  height: 12px;
}

/* ---------- QGroupBox ---------- */
QGroupBox {
  background-color: #FAFAFA;
  border: 1px solid #CCCCCC;
  border-radius: 8px;
  margin-top: 0px;
  padding: 22px 12px 12px 12px;
  color: #333333;
}
QGroupBox::title {
  subcontrol-origin: padding;
  subcontrol-position: top left;
  left: 12px;
  top: 8px;
  padding: 0 4px;
  color: #888888;
  font-size: 12px;
  font-weight: 700;
}
QGroupBox:hover {
  border: 1px solid #007ACC;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
    stop: 0 #1d8fe1, stop: 1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#loginUsername, #loginPassword {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #1d8fe1;
  background: white;
}
QToolButton#loginButton {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #4080ff, stop: 1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#loginButton:hover {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #3070ee, stop: 1 #70b0ff);
}
QToolButton#loginButton:pressed {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #2060dd, stop: 1 #60a0ee);
}
#loginHint {
  color: #e53935;
  font-size: 12px;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
}
QToolButton#loginCloseBtn:hover {
  color: #333;
}

/* ========== ChangePasswordDialog ========== */
#changePasswordDialog {
  background: white;
}
#changePasswordTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#changePasswordOld, #changePasswordNew, #changePasswordConfirm {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#changePasswordOld:focus, #changePasswordNew:focus,
#changePasswordConfirm:focus {
  border-color: #1d8fe1;
  background: white;
}
QToolButton#changePasswordOk {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #4080ff, stop: 1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 8px 24px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#changePasswordOk:hover {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #3070ee, stop: 1 #70b0ff);
}
QToolButton#changePasswordOk:pressed {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #2060dd, stop: 1 #60a0ee);
}
#changePasswordHint {
  color: #e53935;
  font-size: 12px;
}

/* ========== MainWindow 占位页 ========== */
#pagePlaceholderTitle {
  font-size: 28px;
  font-weight: 600;
  color: #1a237e;
}
#pagePlaceholderHint {
  font-size: 14px;
  color: #999;
}
/* ========== QTabWidget / QTabBar ========== */
QTabWidget::pane {
  border: none;
}
QTabBar {
  background: #f5f6fa;
}
QTabBar::tab {
  /* tab 形状由 TabBarStyle（QProxyStyle）自绘，此处不设样式避免冲突 */
}

/* ========== TopBar（顶部栏） ========== */
#topBar {
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #1a237e, stop: 1 #283593);
}
#topBarTitle {
  color: white;
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 1px;
}
#topBarStatus {
  color: rgba(255, 255, 255, 0.85);
  font-size: 13px;
}
#topBarDot[state="green"] {
  color: #4CAF50;
}
#topBarDot[state="gray"] {
  color: #9E9E9E;
}
#topBar QToolButton {
  background: #e8eaf6;
  border: 1px solid #c5cae9;
  border-radius: 4px;
  padding: 4px 12px;
  font-size: 12px;
  color: #1a237e;
}
#topBar QToolButton:hover {
  background: #c5cae9;
}
#topBar QToolButton:checked {
  background: #1a237e;
  color: white;
  border-color: #c5cae9;
}

/* ========== LogFilterBar / LogOutputPanel ========== */
#LogFilterBar {
  background: #f5f6fa;
  border-bottom: 1px solid #e0e0e0;
}
#LogFilterBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 11px;
  color: #666;
}
#LogFilterBar QToolButton:checked {
  background: #e8eaf6;
  border-color: #c5cae9;
  color: #1a237e;
}
#LogFilterBar QToolButton:hover {
  background: #eef1fb;
}
#LogFilterBox {
  border: 1px solid #d7d7d9;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 12px;
}
#LogFilterBox[invalid="true"] {
  border-color: #F44336;
}
#logOutputView {
  background: white;
  border: none;
  font-family: "Consolas", "Microsoft YaHei";
  font-size: 12px;
}

/* ========== ChannelCard / Dashboard ========== */
#channelCard {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
}
#channelCard[state="normal"] {
  background: white;
  border-color: #e0e0e0;
}
#channelCard[state="warning"] {
  background: #fffde7;
  border-color: #FFC107;
}
#channelCard[state="alarm"] {
  background: #ffebee;
  border-color: #F44336;
}
#channelCard[state="offline"] {
  background: #fafafa;
  border-color: #e0e0e0;
}
#channelCardHeader {
  font-size: 13px;
  font-weight: bold;
  color: #333;
}
#channelCardLed {
  border-radius: 6px;
}
#channelCardLed[led="green"] { background-color: #4CAF50; }
#channelCardLed[led="yellow"] { background-color: #FFC107; }
#channelCardLed[led="red"] { background-color: #F44336; }
#channelCardLed[led="gray"] { background-color: #9E9E9E; }
#channelCardValue {
  font-size: 15px;
  font-weight: bold;
  color: #222;
}
#channelCardPressure {
  font-size: 14px;
  font-weight: 600;
  color: #1a237e;
}
#channelCardSensor {
  font-size: 10px;
  color: #999;
}

/* ========== SelfTestPage ========== */
#selfTestPage #selfTestTable {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  font-size: 13px;
}
#selfTestPage QHeaderView::section {
  background: #f5f6fa;
  padding: 6px 10px;
  border: none;
  border-bottom: 2px solid #e0e0e0;
  font-size: 12px;
  color: #666;
  font-weight: 600;
}

/* ========== F5 告警页 ========== */
#alarmTable {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  font-size: 13px;
  gridline-color: #f0f0f0;
}
#alarmTable QHeaderView::section {
  background: #f5f6fa;
  padding: 6px 10px;
  border: none;
  border-bottom: 2px solid #e0e0e0;
  font-size: 12px;
  color: #666;
  font-weight: 600;
}
#alarmTable::item {
  padding: 4px 8px;
}

/* ========== 用户管理对话框 ========== */
#addEditUserHint {
  color: #d32f2f;
}
#userManageTable {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  font-size: 13px;
  gridline-color: #f0f0f0;
}
#userManageTable QHeaderView::section {
  background: #f5f6fa;
  padding: 6px 10px;
  border: none;
  border-bottom: 2px solid #e0e0e0;
  font-size: 12px;
  color: #666;
  font-weight: 600;
}
#userManageTable::item {
  padding: 4px 8px;
}

/* ========== 阈值配置对话框 ========== */
#thresholdDialog {
  background: #fafbfc;
}
#thresholdDialog QLabel {
  color: #333;
}
#thresholdDialog QDoubleSpinBox,
#thresholdDialog QComboBox {
  min-height: 24px;
  border: 1px solid #d0d0d0;
  border-radius: 4px;
  padding: 0 6px;
  background: white;
}

/* ========== SplashScreen（启动画面） ========== */
#splashContent {
  background: white;
  border: 1px solid #D0D0D0;
  border-radius: 12px;
}
#splashLogo {
  background: transparent;
}
#splashTitle {
  background: transparent;
  color: #1E1E1E;
  font-size: 24px;
  font-weight: bold;
}
#splashStatus {
  background: transparent;
  color: #666666;
  font-size: 13px;
}
#splashProgressBar {
  background-color: #E0E0E0;
  border: none;
  border-radius: 4px;
  height: 16px;
  color: #666666;
  font-size: 11px;
  /* QSS 未声明 text-align 时默认左对齐，显式居中 */
  text-align: center;
}
#splashProgressBar::chunk {
  background-color: #007ACC;
  border-radius: 4px;
}

/* ========== LogWindow（日志窗口） ========== */
#logWindow {
  background: white;
}

/* ========== AboutDialog（关于） ========== */
#aboutDialog {
  background: white;
}
#aboutAppName {
  color: #1a237e;
  font-size: 18px;
  font-weight: 600;
}
#aboutInfo {
  color: #333333;
  font-size: 13px;
}
#aboutHint {
  color: #999999;
  font-size: 12px;
}

/* ========== SettingsDialog（设置） ========== */
#settingsDialog {
  background: #fafbfc;
}
/* 左侧分类导航 */
#settingsCategoryList {
  background: #f0f0f0;
  border: none;
  border-right: 1px solid #e0e0e0;
  outline: none;
  padding: 6px 0;
}
#settingsCategoryList::item {
  padding: 8px 12px;
  margin: 2px 8px;
  border: none;
  border-radius: 6px;
  color: #333333;
}
#settingsCategoryList::item:hover {
  background: #e4e4e4;
}
#settingsCategoryList::item:selected {
  background: #d6e8f7;
  color: #1F1F1F;
}
/* 右侧分页区 */
#settingsPageStack {
  background: #fafbfc;
}
#settingsPageTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#settingsPageSub {
  font-size: 12px;
  color: #888888;
}
/* 设置卡片与设置行 */
#settingsCard {
  background: #FFFFFF;
  border: 1px solid #E0E0E0;
  border-radius: 8px;
}
#settingsCardTitle {
  font-size: 12px;
  font-weight: 700;
  color: #888888;
}
#settingsRowTitle {
  font-size: 13px;
  color: #333333;
}
#settingsRowDesc {
  font-size: 11px;
  color: #999999;
}
