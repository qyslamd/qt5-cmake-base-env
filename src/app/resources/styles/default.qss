/* 项目层 · 本仓业务控件
 *
 * 与底座层（base/*.qss）的分工：底座层只写与业务无关的类型/伪状态/子控件/
 * 属性规则；这里只写本仓业务控件的 objectName 规则。加载顺序是底座在前、
 * 本文件在后，本文件里的 id 选择器具体度也更高，两层重合时以本文件为准。
 *
 * 不用 objectName 表达"角色"（主按钮、表单输入、报错文本…）：那是底座层的
 * 动态属性（role="primary"/"form"/"error"）。objectName 留给功能性标识——
 * funq 的控件路径、QtTesting 录制的 XML、funq_target.alias 都依赖它。
 */

/* ========== LoginWindow（角色面板 + 表单）==========
 * 登录窗的规则在 login_window.qss，由 Application 装载；这里不再有旧
 * LoginDialog 的卡片/品牌区规则 */

/* ========== ChangePasswordDialog ========== */
#changePasswordDialog {
  background: white;
}
#changePasswordTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}

/* ========== MainWindow 占位页 ========== */
#pagePlaceholderTitle {
  font-size: 28px;
  font-weight: 600;
  color: #1a237e;
}
#pagePlaceholderHint {
  font-size: 14px;
  color: #999999;
}

/* ========== LogFilterBar / LogOutputPanel ========== */
#LogFilterBar {
  background: #f5f6fa;
  border-bottom: 1px solid #e0e0e0;
}
#LogFilterBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 11px;
  color: #666666;
}
#LogFilterBar QToolButton:checked {
  background: #e8eaf6;
  border-color: #c5cae9;
  color: #1a237e;
}
#LogFilterBar QToolButton:hover {
  background: #eef1fb;
}
#LogFilterBox {
  border: 1px solid #d7d7d9;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 12px;
}
#LogFilterBox[invalid="true"] {
  border-color: #F44336;
}
#logOutputView {
  background: white;
  border: none;
  /* 日志按列对齐，等宽字体 */
  font-family: "Consolas", "Microsoft YaHei";
  font-size: 12px;
}

/* ========== 用户管理对话框 ========== */
/* 表头与单元格样式由底座层的 QHeaderView / QAbstractItemView 提供，
   这里只给表格本体的边框与字号 */
#userManageTable {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  font-size: 13px;
  gridline-color: #f0f0f0;
}

#logWindow {
  background: white;
}

/* ========== AboutDialog（关于） ========== */
#aboutDialog {
  background: white;
}
#aboutAppName {
  color: #1a237e;
  font-size: 18px;
  font-weight: 600;
}
#aboutInfo {
  color: #333333;
  font-size: 13px;
}
#aboutHint {
  color: #999999;
  font-size: 12px;
}
/* 本次运行的命令行：只读，文本可选中复制（字体在代码里取系统等宽） */
#aboutCommandLineTitle {
  color: #1a237e;
  font-size: 13px;
  font-weight: 600;
}
#aboutCommandLine {
  color: #444444;
}

/* ========== CrashReportDialog（崩溃报告） ========== */
/* 按钮走底座层的 role=primary/secondary，这里只给本体与两段文字 */
#crashReportDialog {
  background: white;
}
#crashReportTitle {
  color: #1a237e;
  font-size: 16px;
  font-weight: 600;
}
#crashReportDetail {
  color: #333333;
  font-size: 13px;
}

/* ========== SettingsDialog（设置） ========== */
#settingsDialog {
  background: #fafbfc;
}
/* 顶部"需重启生效"横幅：登录、崩溃捕获后端、日志文件等启动时读一次的设置 */
#settingsRestartBanner {
  background: #fdf6e3;
  border-bottom: 1px solid #eee3c4;
}
/* 左侧分类导航 */
#settingsCategoryList {
  background: #f0f0f0;
  border: none;
  border-right: 1px solid #e0e0e0;
  outline: none;
  padding: 6px 0;
}
#settingsCategoryList::item {
  padding: 8px 12px;
  margin: 2px 8px;
  border: none;
  border-radius: 6px;
  color: #333333;
}
#settingsCategoryList::item:hover {
  background: #e4e4e4;
}
#settingsCategoryList::item:selected {
  background: #d6e8f7;
  color: #1F1F1F;
}
/* 右侧分页区 */
#settingsPageStack {
  background: #fafbfc;
}
#settingsPageTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#settingsPageSub {
  font-size: 12px;
  color: #888888;
}
/* 设置卡片与设置行 */
#settingsCard {
  background: #FFFFFF;
  border: 1px solid #E0E0E0;
  border-radius: 8px;
}
#settingsCardTitle {
  font-size: 12px;
  font-weight: 700;
  color: #888888;
}
#settingsRowTitle {
  font-size: 13px;
  color: #333333;
}
#settingsRowDesc {
  font-size: 11px;
  color: #999999;
}
