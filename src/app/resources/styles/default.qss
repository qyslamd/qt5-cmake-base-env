/* 项目层 · 本仓业务控件
 *
 * 与底座层（base/*.qss）的分工：底座层只写与业务无关的类型/伪状态/子控件/
 * 属性规则；这里只写本仓业务控件的 objectName 规则。加载顺序是底座在前、
 * 本文件在后，本文件里的 id 选择器具体度也更高，两层重合时以本文件为准。
 *
 * 不用 objectName 表达"角色"（主按钮、表单输入、报错文本…）：那是底座层的
 * 动态属性（role="primary"/"form"/"error"）。objectName 留给功能性标识——
 * funq 的控件路径、QtTesting 录制的 XML、gallery.alias 都依赖它。
 */

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
    stop: 0 #1d8fe1, stop: 1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999999;
  font-size: 18px;
}
QToolButton#loginCloseBtn:hover {
  color: #333333;
}

/* ========== ChangePasswordDialog ========== */
#changePasswordDialog {
  background: white;
}
#changePasswordTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}

/* ========== MainWindow 占位页 ========== */
#pagePlaceholderTitle {
  font-size: 28px;
  font-weight: 600;
  color: #1a237e;
}
#pagePlaceholderHint {
  font-size: 14px;
  color: #999999;
}

/* ========== LogFilterBar / LogOutputPanel ========== */
#LogFilterBar {
  background: #f5f6fa;
  border-bottom: 1px solid #e0e0e0;
}
#LogFilterBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 11px;
  color: #666666;
}
#LogFilterBar QToolButton:checked {
  background: #e8eaf6;
  border-color: #c5cae9;
  color: #1a237e;
}
#LogFilterBar QToolButton:hover {
  background: #eef1fb;
}
#LogFilterBox {
  border: 1px solid #d7d7d9;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 12px;
}
#LogFilterBox[invalid="true"] {
  border-color: #F44336;
}
#logOutputView {
  background: white;
  border: none;
  /* 日志按列对齐，等宽字体 */
  font-family: "Consolas", "Microsoft YaHei";
  font-size: 12px;
}

/* ========== 用户管理对话框 ========== */
/* 表头与单元格样式由底座层的 QHeaderView / QAbstractItemView 提供，
   这里只给表格本体的边框与字号 */
#userManageTable {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  font-size: 13px;
  gridline-color: #f0f0f0;
}

/* ========== SplashScreen（启动画面） ========== */
/* 跨仓契约：下列 objectName 由 qt-libui 的 SplashScreen 设置（见其
   splash_screen.cpp）。改名前请同步确认该库未改名，否则此处样式静默失效。
   进度条的底色、高度、文字居中已由底座层的 QProgressBar 提供，这里只覆盖
   它自己的强调色 */
#splashContent {
  background: white;
  border: 1px solid #D0D0D0;
  border-radius: 12px;
}
#splashLogo {
  background: transparent;
}
#splashTitle {
  background: transparent;
  color: #1E1E1E;
  font-size: 24px;
  font-weight: bold;
}
#splashStatus {
  background: transparent;
  color: #666666;
  font-size: 13px;
}
#splashProgressBar::chunk {
  background-color: #007ACC;
  border-radius: 4px;
}

/* ========== LogWindow（日志窗口） ========== */
#logWindow {
  background: white;
}

/* ========== AboutDialog（关于） ========== */
#aboutDialog {
  background: white;
}
#aboutAppName {
  color: #1a237e;
  font-size: 18px;
  font-weight: 600;
}
#aboutInfo {
  color: #333333;
  font-size: 13px;
}
#aboutHint {
  color: #999999;
  font-size: 12px;
}

/* ========== SettingsDialog（设置） ========== */
#settingsDialog {
  background: #fafbfc;
}
/* 左侧分类导航 */
#settingsCategoryList {
  background: #f0f0f0;
  border: none;
  border-right: 1px solid #e0e0e0;
  outline: none;
  padding: 6px 0;
}
#settingsCategoryList::item {
  padding: 8px 12px;
  margin: 2px 8px;
  border: none;
  border-radius: 6px;
  color: #333333;
}
#settingsCategoryList::item:hover {
  background: #e4e4e4;
}
#settingsCategoryList::item:selected {
  background: #d6e8f7;
  color: #1F1F1F;
}
/* 右侧分页区 */
#settingsPageStack {
  background: #fafbfc;
}
#settingsPageTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#settingsPageSub {
  font-size: 12px;
  color: #888888;
}
/* 设置卡片与设置行 */
#settingsCard {
  background: #FFFFFF;
  border: 1px solid #E0E0E0;
  border-radius: 8px;
}
#settingsCardTitle {
  font-size: 12px;
  font-weight: 700;
  color: #888888;
}
#settingsRowTitle {
  font-size: 13px;
  color: #333333;
}
#settingsRowDesc {
  font-size: 11px;
  color: #999999;
}
