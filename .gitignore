# ============================================================
# Taihang Zhendong - C++/Qt 项目 Git 忽略规则
# ============================================================

# ---------- 通用 ----------
# 临时/备份文件
*~
*.bak
*.swp
*.tmp
*.temp
*.log
*.orig
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# 编辑器/IDE 通用
# .vscode/ 已纳入仓库：其中的配置作为模板的一部分，供克隆后直接使用。
# 若需放本机私有配置，改用 .vscode/settings.local.json 之类的个人文件。
.idea/
*.iml
.cache/

# clangd：由 cmake/.clangd.in 生成，内含本机构建路径，不入库
.clangd

