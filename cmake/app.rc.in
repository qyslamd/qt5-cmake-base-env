#pragma code_page(65001)

#include <windows.h>

IDI_ICON1 ICON "@APP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,@APP_VERSION_TWEAK@
 PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,@APP_VERSION_TWEAK@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "@APP_ORG_NAME@"
            VALUE "FileDescription",  "@APP_APP_NAME@"
            VALUE "FileVersion",      "@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@.@APP_VERSION_TWEAK@"
            VALUE "InternalName",     "@TARGET_NAME@"
            VALUE "LegalCopyright",   "Copyright @APP_ORG_NAME@"
            VALUE "OriginalFilename", "@TARGET_NAME@.exe"
            VALUE "ProductName",      "@APP_APP_NAME@"
            VALUE "ProductVersion",   "@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@.@APP_VERSION_TWEAK@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
