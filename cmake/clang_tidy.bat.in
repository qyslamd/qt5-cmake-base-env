@echo off
REM Auto-generated by CMake - do not edit
REM
REM Launcher for clang_tidy.ps1. All arguments are passed through:
REM   clang_tidy.bat -BuildDir build\ninja-debug-x86
REM   clang_tidy.bat -Fix
REM   clang_tidy.bat -Files src\app\main.cpp
REM
REM The real work lives in the PowerShell script; this wrapper only exists so
REM the tool can be invoked with the same muscle memory as the other scripts
REM in this directory.
REM
REM NOTE: keep this file ASCII-only. cmd.exe decodes batch files with the OEM
REM codepage, so non-ASCII text would be torn apart and its fragments executed
REM as commands.

setlocal

set "SCRIPT=%~dp0clang_tidy.ps1"
if not exist "%SCRIPT%" (
    echo Error: %SCRIPT% not found.
    echo Re-run CMake configure to regenerate it.
    exit /b 1
)

where pwsh >nul 2>&1
if errorlevel 1 (
    echo Error: pwsh not found. PowerShell 7 or later is required.
    echo Install it from https://aka.ms/powershell, or run clang_tidy.ps1 directly.
    exit /b 1
)

pwsh -NoProfile -ExecutionPolicy Bypass -File "%SCRIPT%" %*
exit /b %errorlevel%
