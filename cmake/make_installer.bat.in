@echo off
REM Auto-generated by CMake - do not edit
REM Usage: make_installer.bat <bin_dir>
REM
REM NOTE: keep this file ASCII-only. cmd.exe decodes batch files with the OEM
REM codepage, so non-ASCII text (e.g. UTF-8 Chinese) gets torn apart and its
REM fragments are executed as commands. "chcp 65001" does not reliably fix
REM this because the parser has already decoded the line being executed.

set ISCC=@ISCC_EXECUTABLE@
set ISS_SCRIPT=@ISS_FILE@
set EXPECTED_BIN=@ISCC_WHERE_ARE_FILES@

REM The .iss lives in the source tree and is shared by all build configurations;
REM its content depends on the configuration (bin path / AppId / arch). If the
REM current build directory was not re-configured, it may still hold another
REM configuration's values, which would silently produce a wrong installer.
REM Fail loudly instead.
if /i not "%~1"=="%EXPECTED_BIN%" (
    echo [ERROR] Iss script does not match the current build configuration.
    echo         Expected bin: %EXPECTED_BIN%
    echo         Received bin: %~1
    echo         Re-run configure ^(e.g. scripts\build_ninja.bat^) and retry.
    exit /b 2
)

echo Running Inno Setup...
"%ISCC%" /Qp "%ISS_SCRIPT%"
if errorlevel 1 (
    echo ISCC failed with error code %errorlevel%
    exit /b %errorlevel%
)

echo Package created!
