; Script generated by CMake from make_install_package.iss.in
; Inno Setup 6 脚本 — 生成windows的安装包

#define WhereAreFiles "@ISCC_WHERE_ARE_FILES@"

#define MyAppName "测试程序"
#define MyCompanyName ""
#define MyAppPublisher ""
#define MyAppURL ""
#define MyAppMutex "@PROJECT_NAME@Mutex"
#define MyInstallerIcon "@APP_ICON_ICO@"

[Setup]
AppId=@ISCC_APP_ID@
AppName={#MyAppName}
AppVersion=@APP_VERSION@
AppPublisher={#MyAppPublisher}
DefaultDirName=@ISCC_APP_PF@\{#MyCompanyName}@PROJECT_NAME@
DefaultGroupName=@PROJECT_NAME@
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
#if "@ISCC_USE_64BIT@" == "YES"
ArchitecturesInstallIn64BitMode=x64compatible
#endif
OutputDir=@PACKAGE_OUTPUT_DIR@
OutputBaseFilename={#MyAppName}-setup-@ISCC_APP_ARCH_SUFFIX@-@APP_VERSION@
Compression=lzma
SolidCompression=yes
WizardStyle=modern
SetupIconFile={#MyInstallerIcon}
Uninstallable=yes
UninstallDisplayName={#MyAppName}

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone
Name: "installvcruntime"; Description: "安装 VC++ 运行库"; GroupDescription: "系统组件："; Flags: checkablealone

[Files]
; @TARGET_NAME@ 主程序
Source: "{#WhereAreFiles}\@TARGET_NAME@.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#WhereAreFiles}\Qt5*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#WhereAreFiles}\@ISCC_VC_REDIST@"; DestDir: "{app}"; Flags: ignoreversion

; Qt 运行时插件目录
; windeployqt 只部署程序实际用到的插件目录，故按依赖 Qt 模块而存在的
; 目录（sqldrivers 等）必须带 skipifsourcedoesntexist，否则打包直接报错
;Source: "{#WhereAreFiles}\bearer\*.dll"; DestDir: "{app}\bearer"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\iconengines\*.dll"; DestDir: "{app}\iconengines"; Flags: ignoreversion
Source: "{#WhereAreFiles}\imageformats\*.dll"; DestDir: "{app}\imageformats"; Flags: ignoreversion
Source: "{#WhereAreFiles}\platforms\*.dll"; DestDir: "{app}\platforms"; Flags: ignoreversion
Source: "{#WhereAreFiles}\styles\*.dll"; DestDir: "{app}\styles"; Flags: ignoreversion
Source: "{#WhereAreFiles}\sqldrivers\*.dll"; DestDir: "{app}\sqldrivers"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\translations\*.qm"; DestDir: "{app}\translations"; Flags: ignoreversion skipifsourcedoesntexist

; 配置 + 数据（模板示例，项目未必有这些目录）
Source: "{#WhereAreFiles}\config\*"; DestDir: "{app}\config"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "{#WhereAreFiles}\calibration\*"; DestDir: "{app}\calibration"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\@TARGET_NAME@.exe"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]

var
  DeleteUserData: Boolean;

// VC++ 运行库由 [Tasks] 的 installvcruntime 复选框控制。
// 该安装包需要管理员权限，故用 runas 触发 UAC 提权后静默安装；
// ewNoWait 表示不阻塞安装流程。
procedure CurStepChanged(CurStep: TSetupStep);
var
  ErrorCode: Integer;
  VcRedistPath: String;
begin
  if CurStep = ssPostInstall then
  begin
    if IsTaskSelected('installvcruntime') then
    begin
      VcRedistPath := ExpandConstant('{app}\@ISCC_VC_REDIST@');
      if FileExists(VcRedistPath) then
      begin
        ShellExec('runas', VcRedistPath,
                  '/install /quiet /norestart',
                  '', SW_SHOW, ewNoWait, ErrorCode);
      end;
    end;
  end;
end;

function InitializeSetup(): Boolean;
var
  ErrorCode: Integer;
begin
  if CheckForMutexes('{#MyAppMutex}') then
  begin
    if MsgBox('检测到 {#MyAppName} 正在运行，是否关闭后继续安装？',
              mbConfirmation, MB_YESNO) = IDYES then
    begin
      ShellExec('open', ExpandConstant('{cmd}'),
        '/c taskkill /f /t /im @TARGET_NAME@.exe', '',
        SW_HIDE, ewNoWait, ErrorCode);
      Result := True;
    end
    else
      Result := False;
  end
  else
    Result := True;
end;
