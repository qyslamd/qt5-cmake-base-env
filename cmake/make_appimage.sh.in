#!/bin/bash
# AppImage 打包脚本：由 CMake configure_file 生成，不要手动编辑。
# 模板见 cmake/make_appimage.sh.in，对应 Windows 侧的 scripts/make_installer.bat。
#
# 流程：
#   1. 校验构建配置（Debug 拒绝打包，与 Windows 侧共用同一个检查脚本）
#   2. 铺 AppDir：cmake --install 装入 usr/bin，配置与数据目录按 Windows 侧
#      同样的布局放在可执行文件旁边
#   3. linuxdeploy 收集依赖，并由 qt 插件打包 Qt 库、平台插件与翻译
#   4. strip AppDir 里的可执行文件，再交由 appimagetool 产出 .AppImage
#   5. 归档未 strip 的可执行文件：崩溃日志里只有裸地址，事后 addr2line 必须
#      用与打包那一刻一致的未 strip 二进制，对应 Windows 侧的符号归档
#
# 三个打包工具与 type2 runtime 随仓库提供在 3rdparty/appimage-tools/，无需联网。
# 脚本会导出 APPIMAGE_EXTRACT_AND_RUN，让工具免 FUSE 自解包运行，容器与 CI 同样可用。
#
# 第 1 步之前还有一道前置校验：本脚本生成在**源码树**里，同一棵源码树的多个
# 构建目录（debug / relwithdebinfo / release）共用这一个文件，后 configure 的
# 会覆盖先前的。此时从旧构建目录里跑 make_appimage，执行的其实是别人的脚本
# ——轻则找不到二进制，重则把 Debug 打包的拦截一起绕过去。故要求调用方传入
# 构建目录，与脚本里烧死的那个不符就立即退出（退出码 2），对应 Windows 侧
# make_installer.bat 里的 EXPECTED_BIN 校验。
#
# 用法：
#   make_appimage.sh <可执行文件所在目录>      # make_appimage 目标会自动传入
#   （直接调用时也要给，否则这道校验无从比对）
#
# Qt 由 configure 时定位到的 qmake 注入（与工程链接的是同一套）；要改用别的
# Qt，导出 QMAKE 覆盖即可：
#   QMAKE=/opt/Qt/5.15.2/gcc_64/bin/qmake ./scripts/make_appimage.sh <bin 目录>

set -euo pipefail

APP_NAME="@APP_APP_NAME@"
APP_VERSION="@APP_VERSION@"
TARGET_NAME="@TARGET_NAME@"
APPIMAGE_ARCH="@APPIMAGE_ARCH@"
BUILD_DIR="@APPIMAGE_BUILD_DIR@"
OUTPUT_DIR="@APPIMAGE_OUTPUT_DIR@"
TOOLS_DIR="@APPIMAGE_TOOLS_DIR@"
WORK_DIR="@APPIMAGE_WORK_DIR@"
DESKTOP_SRC="@APPIMAGE_DESKTOP_FILE@"
ICON_SRC="@APPIMAGE_ICON_FILE@"
SYMBOLS_DIR="@APPIMAGE_SYMBOLS_DIR@"
BUILD_TYPE="@CMAKE_BUILD_TYPE@"
CHECK_SCRIPT="@APPIMAGE_CHECK_SCRIPT@"
QT_QMAKE="@QT_QMAKE_EXECUTABLE@"
CMAKE="@CMAKE_COMMAND@"

APP_DIR="$WORK_DIR/${APP_NAME}.AppDir"
BIN_DIR="$BUILD_DIR/bin"
EXE_NAME="${TARGET_NAME}"
# 工具的架构后缀与 APPIMAGE_ARCH 同源：仓库里放的就是这个架构的一套
TOOL_SUFFIX="$APPIMAGE_ARCH"
# appimagetool 产出 AppImage 时要嵌入的 type2 runtime，同样随仓库提供
RUNTIME_FILE="$TOOLS_DIR/runtime-${TOOL_SUFFIX}"

die() {
    echo "错误：$*" >&2
    exit 1
}

# ---- 0. 脚本与构建目录的匹配校验（理由见文件头；与 Windows 侧同退出码 2）----
# 写 ${1:-} 而不是 $1：未传参时 $1 在 set -u 下会直接报错，而这里要的是一句人话
if [ "${1:-}" != "$BIN_DIR" ]; then
    echo "错误：打包脚本与当前构建目录不匹配。" >&2
    echo "  脚本里的构建目录：$BIN_DIR" >&2
    echo "  本次传入的：${1:-（未传参）}" >&2
    echo "  该脚本生成在源码树、被所有构建目录共用，后 configure 的会覆盖先前的。" >&2
    echo "  重新 configure 当前构建目录后重试，例如：" >&2
    echo "    ./scripts/build_ninja.sh -t relwithdebinfo -p" >&2
    exit 2
fi

# ---- 1. 构建配置校验（与 make_appimage 目标走同一个脚本，直接调用本脚本也拦得住）----
"$CMAKE" -DBUILD_TYPE="$BUILD_TYPE" -DPLATFORM=LINUX -P "$CHECK_SCRIPT"

# ---- 2. 前置检查：缺什么就直说缺什么，不留下半截产物 ----
[ -x "$BIN_DIR/$EXE_NAME" ] || die "未找到 $BIN_DIR/$EXE_NAME，请先构建"
[ -f "$ICON_SRC" ] || die "缺少图标 $ICON_SRC（AppImage 需要 256x256 PNG）"
[ -f "$DESKTOP_SRC" ] || die "缺少 $DESKTOP_SRC，请重新运行 configure 生成"
command -v strip >/dev/null || die "缺少 strip（binutils），无法裁剪发布二进制"

for tool in linuxdeploy linuxdeploy-plugin-qt appimagetool; do
    tool_path="$TOOLS_DIR/${tool}-${TOOL_SUFFIX}.AppImage"
    if [ ! -f "$tool_path" ]; then
        die "缺少 $tool_path（打包工具随仓库提供，见 3rdparty/appimage-tools/README.md；
若本次目标架构不是 ${TOOL_SUFFIX}，需自行为该架构补齐这一套工具）"
    fi
    # Windows 侧克隆时权限位可能丢失，这里补一次
    chmod +x "$tool_path" 2>/dev/null || true
done

# type2 runtime：appimagetool 必须把它嵌进 AppImage。不给 --runtime-file 时它会
# 自己从 GitHub 的 release CDN 拉，而那条线路国内常常不可达——且这个下载没有
# 超时，卡住时进程 CPU 为 0、看着像在压缩，实际是干等。故与三个工具一样入库
[ -f "$RUNTIME_FILE" ] || die "缺少 $RUNTIME_FILE（type2 runtime 随仓库提供，
见 3rdparty/appimage-tools/README.md）"

# ---- 3. 铺 AppDir ----
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/usr"
"$CMAKE" --install "$BUILD_DIR" --prefix "$APP_DIR/usr" >/dev/null

# 配置与数据目录：模板示例，项目未必有，与 Windows 侧同样放在可执行文件旁
for data_dir in config calibration; do
    if [ -e "$BIN_DIR/$data_dir" ]; then
        cp -a "$BIN_DIR/$data_dir" "$APP_DIR/usr/bin/"
    fi
done

# ---- 4. linuxdeploy：收集依赖 + qt 插件打包 Qt ----
# APPIMAGE_EXTRACT_AND_RUN 让工具免 FUSE 自解包；QMAKE 默认取 configure 时
# 定位到的那份，保证打包的 Qt 与工程链接的是同一套
export APPIMAGE_EXTRACT_AND_RUN=1
if [ -n "$QT_QMAKE" ]; then
    export QMAKE="${QMAKE:-$QT_QMAKE}"
fi

# 插件必须以 linuxdeploy-plugin-qt 这个名字出现在 PATH 里，linuxdeploy 才认
PLUGIN_DIR="$WORK_DIR/tools"
mkdir -p "$PLUGIN_DIR"
ln -sf "$TOOLS_DIR/linuxdeploy-plugin-qt-${TOOL_SUFFIX}.AppImage" \
       "$PLUGIN_DIR/linuxdeploy-plugin-qt"

# .desktop 与图标传源文件，由 linuxdeploy 自行放进 AppDir 根目录；
# --icon-filename 让落地的图标名与 .desktop 里的 Icon= 一致（源文件名是
# icon.png，而 Icon= 用的是应用名，不对齐就会找不到图标）
PATH="$PLUGIN_DIR:$PATH" "$TOOLS_DIR/linuxdeploy-${TOOL_SUFFIX}.AppImage" \
    --appdir "$APP_DIR" \
    --desktop-file "$DESKTOP_SRC" \
    --icon-file "$ICON_SRC" \
    --icon-filename "$APP_NAME" \
    --plugin qt

# ---- 5. 裁剪 + 打包 ----
strip --strip-unneeded "$APP_DIR/usr/bin/$EXE_NAME"

mkdir -p "$OUTPUT_DIR"
APPIMAGE_FILE="$OUTPUT_DIR/${APP_NAME}-${APPIMAGE_ARCH}-${APP_VERSION}.AppImage"
ARCH="$APPIMAGE_ARCH" VERSION="$APP_VERSION" \
    "$TOOLS_DIR/appimagetool-${TOOL_SUFFIX}.AppImage" -n \
    --runtime-file "$RUNTIME_FILE" \
    "$APP_DIR" "$APPIMAGE_FILE"

# ---- 6. 归档未 strip 的可执行文件（Windows 侧由 make_symbols 目标负责）----
mkdir -p "$SYMBOLS_DIR"
cp "$BIN_DIR/$EXE_NAME" "$SYMBOLS_DIR/"

echo
echo "AppImage 已生成：$APPIMAGE_FILE"
echo "符号已归档：$SYMBOLS_DIR/$EXE_NAME"
echo "  崩溃日志中的裸地址用：addr2line -e $SYMBOLS_DIR/$EXE_NAME -f -C <地址>"
