#!/bin/bash
# Run script: generated by CMake configure_file, do not edit by hand.
#
# On Linux Qt is resolved through system paths (ld.so searches the libraries, Qt
# searches for plugins under its own prefix), so extra environment variables are
# normally unnecessary. Uncomment the lines below when using a non-system Qt.

# export LD_LIBRARY_PATH="@QT_LIB_DIR@:${LD_LIBRARY_PATH}"
# export QT_PLUGIN_PATH="@QT_PLUGINS_DIR@"
# export QT_DEBUG_PLUGINS=1   # enable when troubleshooting plugin loading

cd "@RUN_DIR@" || exit 1

./@TARGET_NAME@ @PROGRAM_ARGS@ "$@"
