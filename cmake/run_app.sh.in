#!/bin/bash
# 运行脚本：由 CMake configure_file 生成，不要手动编辑。
#
# Linux 下 Qt 由系统路径解析（ld.so 搜索库、Qt 按自身前缀搜索插件），
# 通常无需额外环境变量。使用非系统 Qt 时按需取消下列注释。

# export LD_LIBRARY_PATH="@QT_LIB_DIR@:${LD_LIBRARY_PATH}"
# export QT_PLUGIN_PATH="@QT_PLUGINS_DIR@"
# export QT_DEBUG_PLUGINS=1   # 排查插件加载问题时打开

cd "@RUN_DIR@" || exit 1

./@TARGET_NAME@ @PROGRAM_ARGS@ "$@"
