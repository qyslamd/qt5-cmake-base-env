@echo off
setlocal enabledelayedexpansion

set CLOC="@CLOC_EXECUTABLE@"

if not exist %CLOC% (
    echo Error: cloc.exe not found at %CLOC%
    exit /b 1
)

echo ========================================
echo  @PROJECT_NAME@ Code Line Count
echo ========================================
echo.

%CLOC% --exclude-dir=3rdparty,build,.git,cmake-build,out,Release,Debug ^
       --exclude-ext=md,txt,bat,ps1,json,ini,iss,svg ^
       "@CMAKE_SOURCE_DIR@/src" "@CMAKE_SOURCE_DIR@/tests" 2>&1

echo.
echo Done!
endlocal
