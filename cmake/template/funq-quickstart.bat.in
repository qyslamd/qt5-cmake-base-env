@echo off
chcp 65001 >nul
rem funq - one-click self test.
rem
rem Same as running funq-server.bat and funq-self-test.bat in two windows, for
rem the times you just want to see the whole thing work: it starts the
rem application with libFunQ injected (in a separate minimised window) and then
rem drives it through a few steps, printing what it sees at each step.
rem
rem Everything is resolved relative to this script's own folder, so the product
rem can be installed anywhere. Generated by CMake - do not edit.
rem
rem Extra arguments are passed through to the client (see its --help).

setlocal
set "FUNQ_DIR=%~dp0"
set "APP_EXE=%FUNQ_DIR%..\@TARGET_NAME@.exe"
set "PY=%FUNQ_DIR%python\python.exe"

rem Qt runtime: the application's own folder first, then the extra Qt modules the
rem injector needs but the application does not (collected into qt\ at build time)
set "PATH=%FUNQ_DIR%..;%FUNQ_DIR%qt;%PATH%"

if not exist "%APP_EXE%" (
    echo Application not found: %APP_EXE%
    echo This script must stay next to the installed application.
    pause
    exit /b 1
)

rem With an existing instance the runner starts a process that gets swallowed by
rem the application's single instance check and then reports an error that does
rem not explain itself - say it clearly here instead
"%PY%" -u "%FUNQ_DIR%check_no_instance.py" --name @APP_APP_NAME@
if errorlevel 1 (
    echo.
    echo Not started. Close the running @APP_APP_NAME@ and run this script again.
    pause
    exit /b 1
)

echo Starting @APP_APP_NAME@ with libFunQ injected on localhost:@FUNQ_DEMO_PORT@
echo The client in this window drives it and prints what it sees. Keep it open.
echo.

rem The server gets its own minimised window: it must outlive this script's
rem client, and closing it is how you stop the tested program.
start "funq server" /min "%PY%" -u -m funq_server.runner --port @FUNQ_DEMO_PORT@ --library "%FUNQ_DIR%server\funq_server\libFunQ.dll" "%APP_EXE%"

rem -u on every python call (see the note in funq-server.bat): to a console stdout
rem is line buffered, but redirecting it (funq-quickstart.bat > log) switches it
rem to block buffering - the whole run then arrives as one lump at the end
"%PY%" -u "%FUNQ_DIR%funq_client_demo.py" --port @FUNQ_DEMO_PORT@ %*
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
    echo.
    echo The self test reported problems ^(exit code %RC%^) - see the summary above.
    echo If an @APP_APP_NAME@ window or a minimised "funq server" window is still
    echo around, close it before running this script again.
)
echo.
pause
exit /b %RC%
