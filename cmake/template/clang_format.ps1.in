# @PROJECT_NAME@ clang-format
#
# Generated by CMake configure_file. The clang-format path and the source
# root are resolved on this machine, so this file needs no editing. The style
# rules live in the repository root's .clang-format.
#
# Usage:
#   scripts\clang_format.ps1                      format the C/C++ files git reports as changed
#   scripts\clang_format.ps1 -All                 format every C/C++ file under src/, tests/, examples/
#   scripts\clang_format.ps1 -Files src\app\main.cpp
#   scripts\clang_format.ps1 -Files src\a.cpp,src\b.cpp   multiple: comma separated
#   scripts\clang_format.ps1 -Check               change nothing, report and exit 1 if a file is off
#
# Exit code:
#   0  every file is formatted (with -Check: nothing would change)
#   1  -Check found files that would change, or clang-format / git failed
#
# The point of the default mode is CLAUDE.md rule 20: a commit must only touch
# files that are already formatted, and "the files I changed" is exactly what
# git reports. Review the result with git diff before committing.
#
# NOTE: this file must stay ASCII-only and must avoid PowerShell 7 only
# syntax. It runs under the built-in Windows PowerShell as well as under
# pwsh: Windows PowerShell decodes a BOM-less file using the ANSI codepage,
# so non-ASCII text would come out garbled, and constructs such as
# ForEach-Object -Parallel or $using: are not available before version 7.

# Positional binding is disabled for the same reason as in clang_tidy.ps1: a
# stray token would otherwise be bound to whichever parameter comes next in
# declaration order, silently.
[CmdletBinding(PositionalBinding = $false)]
param(
    # Files to format. Defaults to what git reports as changed, so the script
    # never rewrites a file its author did not touch.
    [string[]]$Files,

    # Format every C/C++ file under the source tree instead of the changed
    # ones. Expect a large diff the first time it runs.
    [switch]$All,

    # Report instead of rewriting. Exits 1 when any file is not formatted,
    # which is the check to run before a commit.
    [switch]$Check
)

$ErrorActionPreference = 'Stop'

$clangFormat = "@CLANG_FORMAT_EXECUTABLE@"
$srcRoot = "@CMAKE_SOURCE_DIR@"

# Extensions that belong to this repository's C++ sources. Compared in lower
# case below, so the case in which a file is named does not matter.
$extensions = @('.h', '.hpp', '.cpp', '.cc', '.cxx')

# Resolve relative paths against the repository root rather than the current
# directory, so the script behaves the same wherever it is invoked from.
function Resolve-RepoPath {
    param([string]$Path)

    if ([System.IO.Path]::IsPathRooted($Path)) {
        return [System.IO.Path]::GetFullPath($Path)
    }
    return [System.IO.Path]::GetFullPath((Join-Path $srcRoot $Path))
}

function Test-SourceFile {
    param([string]$Path)

    return ($extensions -contains [System.IO.Path]::GetExtension($Path).ToLowerInvariant())
}

# clang-format reports "would reformat" and any parse error on stderr, and
# Windows PowerShell turns a native command's stderr into an ErrorRecord --
# with $ErrorActionPreference = 'Stop' that aborts the whole run on the first
# offending file, leaving the rest unchecked. Relax the preference for the
# call and capture both streams instead.
function Invoke-ClangFormat {
    param([string[]]$Arguments)

    $previous = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try {
        $output = & $clangFormat @Arguments 2>&1
    } finally {
        $ErrorActionPreference = $previous
    }

    [pscustomobject]@{
        Output   = ($output | Out-String)
        ExitCode = $LASTEXITCODE
    }
}

if (-not (Test-Path $clangFormat)) {
    Write-Host "Error: clang-format not found at $clangFormat"
    Write-Host "Re-run CMake configure to regenerate this script."
    exit 1
}

if ($Files) {
    # A comma separated value arrives as one literal string when the script
    # is started with -File, so split it here. Splitting an already split
    # array is harmless, which keeps both call styles working.
    $requested = @()
    foreach ($entry in $Files) {
        foreach ($part in ($entry -split ',')) {
            $trimmed = $part.Trim()
            if ($trimmed -ne '') {
                $requested += $trimmed
            }
        }
    }

    $Files = @()
    foreach ($item in $requested) {
        $Files += (Resolve-RepoPath $item)
    }

    $missing = @($Files | Where-Object { -not (Test-Path $_) })
    if ($missing.Count -gt 0) {
        Write-Host "Error: file(s) not found:"
        foreach ($m in $missing) { Write-Host "  $m" }
        exit 1
    }
} elseif ($All) {
    # Guard each directory individually: a template derived from this repo
    # may well have dropped examples/ or tests/.
    $searchDirs = @()
    foreach ($name in @('src', 'tests', 'examples')) {
        $candidate = Join-Path $srcRoot $name
        if (Test-Path $candidate) {
            $searchDirs += $candidate
        }
    }

    if ($searchDirs.Count -eq 0) {
        Write-Host "Error: none of src, tests, examples found under $srcRoot"
        exit 1
    }

    $Files = @(
        Get-ChildItem -Path $searchDirs -Recurse -File |
        Where-Object { Test-SourceFile $_.FullName } |
        Sort-Object FullName |
        ForEach-Object { $_.FullName }
    )
} else {
    $git = Get-Command git -ErrorAction SilentlyContinue
    if (-not $git) {
        Write-Host "Error: git not found on PATH; pass -Files or -All instead."
        exit 1
    }

    # git writes UTF-8, Windows PowerShell decodes native command output with
    # the console code page (GBK on a Chinese install), so pin the decoder
    # before reading anything back.
    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8

    # -z gives NUL separated, unquoted paths, which sidesteps git's quoting of
    # non-ASCII names. --no-renames turns a rename into delete + add, so the
    # file's new path is picked up like any other change instead of arriving
    # in the special "old -> new" form.
    $status = & git -C $srcRoot status --porcelain -z --no-renames --untracked-files=all
    if ($LASTEXITCODE -ne 0) {
        Write-Host "Error: git status failed under $srcRoot"
        exit 1
    }
    if ($null -eq $status) { $status = '' }

    $Files = @()
    foreach ($entry in ($status -split "`0")) {
        # "XY path": two status characters, a space, then the path
        if ($entry.Length -lt 4) { continue }
        $path = $entry.Substring(3).Trim()
        if ($path -eq '') { continue }

        $full = Resolve-RepoPath $path
        # a deleted file is reported but no longer there, and only the C/C++
        # sources are ours to format
        if ((Test-Path $full) -and (Test-SourceFile $full)) {
            $Files += $full
        }
    }
    $Files = @($Files | Sort-Object -Unique)
}

if ($Files.Count -eq 0) {
    Write-Host "No source files to format."
    exit 0
}

$mode = 'rewrite in place'
if ($Check) { $mode = 'check only' }

Write-Host "========================================"
Write-Host " @PROJECT_NAME@ clang-format"
Write-Host " Tool      : $clangFormat"
Write-Host " Files     : $($Files.Count)"
Write-Host " Mode      : $mode"
Write-Host "========================================"
Write-Host ""

$offenders = @()
$failed = 0

foreach ($file in $Files) {
    if ($Check) {
        # --Werror turns "would reformat" into a non-zero exit, so a single
        # pass answers both "does it parse" and "is it formatted".
        $result = Invoke-ClangFormat @('--dry-run', '--Werror', '-style=file', $file)
        if ($result.ExitCode -ne 0) {
            Write-Host "WOULD REFORMAT  $file"
            $detail = @($result.Output -split "[`r`n]+" | Where-Object { $_.Trim() -ne '' })
            if ($detail.Count -gt 0) { Write-Host "    $($detail[0].Trim())" }
            $offenders += $file
        }
    } else {
        $result = Invoke-ClangFormat @('-i', '-style=file', $file)
        if ($result.ExitCode -ne 0) {
            Write-Host "FAILED  $file"
            $detail = @($result.Output -split "[`r`n]+" | Where-Object { $_.Trim() -ne '' })
            if ($detail.Count -gt 0) { Write-Host "    $($detail[0].Trim())" }
            $failed = $failed + 1
        }
    }
}

Write-Host ""

if ($Check) {
    if ($offenders.Count -gt 0) {
        Write-Host "$($offenders.Count) file(s) not formatted. Run without -Check to rewrite them."
        exit 1
    }
    Write-Host "All $($Files.Count) file(s) already formatted."
    exit 0
}

if ($failed -gt 0) {
    Write-Host "clang-format failed on $failed file(s); the rest were rewritten."
    exit 1
}

Write-Host "Done. Review the result with git diff before committing."
exit 0
