@echo off
REM Auto-generated by CMake from cmake/template/export_crash_report.bat.in - do not edit.
REM
REM Exports the crash reports collected by @TARGET_NAME@ so that they can be
REM sent back to the developer. Reports are written as a folder containing the
REM minidump(s) plus a readable summary.txt.
REM
REM Usage: export_crash_report.bat [target directory]
REM        Without an argument the reports go to a CrashReport-<timestamp>
REM        folder on the Desktop.
REM
REM NOTE: keep this file ASCII-only. cmd.exe decodes batch files with the OEM
REM codepage, so non-ASCII text gets torn apart and its fragments are executed
REM as commands. "chcp 65001" does not reliably fix this because the parser has
REM already decoded the line being executed.
REM
REM NOTE: the program is a GUI-subsystem binary, so cmd.exe does not wait for
REM it and %ERRORLEVEL% would be meaningless. "start /wait" is what makes the
REM exit code readable here.

setlocal

set "EXE=%~dp0@TARGET_NAME@.exe"
if not exist "%EXE%" (
    echo [ERROR] not found: %EXE%
    exit /b 1
)

if "%~1"=="" (
    echo Exporting crash reports to the Desktop...
    start /wait "" "%EXE%" --export-report
) else (
    echo Exporting crash reports to "%~1"...
    start /wait "" "%EXE%" --export-report --export-dir "%~1"
)

set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
    echo [ERROR] export failed, exit code %RC%
    echo See the application log under %LOCALAPPDATA% for details.
    exit /b %RC%
)

echo Done.
endlocal
exit /b 0
