; Script generated by CMake from make_install_package.iss.in
; Inno Setup 6 脚本 — 生成windows的安装包

#define WhereAreFiles "@ISCC_WHERE_ARE_FILES@"

; 应用标识：全部由顶层 CMakeLists.txt 注入，此处无需修改。
; 如需与程序名不同的安装包显示名，或与组织名不同的发行者，
; 把对应项改成字面量即可。
#define MyAppName "@APP_APP_NAME@"
#define MyCompanyName "@APP_ORG_NAME@"
#define MyAppPublisher "@APP_ORG_NAME@"
#define MyAppURL "@APP_URL@"
; 与运行时 SingleInstance 创建的命名互斥体同名（见顶层 CMakeLists.txt）
#define MyAppMutex "@APP_MUTEX_NAME@"
#define MyInstallerIcon "@APP_ICON_ICO@"

; Crashpad handler 是否随包分发。CMake 注入 1 或 0：
;   1 = APP_ENABLE_CRASHPAD=ON 的构建，bin\ 下有 crashpad_handler.exe
;   0 = 自研崩溃处理，进程内捕获，无外部依赖文件
#define HasCrashpadHandler @ISCC_APP_HAS_CRASHPAD@

[Setup]
AppId=@ISCC_APP_ID@
AppName={#MyAppName}
AppVersion=@APP_VERSION@
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
; 安装目录 {autopf}\<组织名>\<应用名>，与 %LOCALAPPDATA% 下的数据目录同构
; MyCompanyName 为空时 Windows 会归一化掉多余的分隔符
DefaultDirName=@ISCC_APP_PF@\{#MyCompanyName}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
#if "@ISCC_USE_64BIT@" == "YES"
ArchitecturesInstallIn64BitMode=x64compatible
#endif
OutputDir=@PACKAGE_OUTPUT_DIR@
OutputBaseFilename={#MyAppName}-setup-@APP_ARCH_SUFFIX@-@APP_VERSION@
Compression=lzma
SolidCompression=yes
WizardStyle=modern
SetupIconFile={#MyInstallerIcon}
Uninstallable=yes
UninstallDisplayName={#MyAppName}

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone
Name: "installvcruntime"; Description: "安装 VC++ 运行库"; GroupDescription: "系统组件："; Flags: checkablealone

[Files]
; @TARGET_NAME@ 主程序
Source: "{#WhereAreFiles}\@TARGET_NAME@.exe"; DestDir: "{app}"; Flags: ignoreversion
; Crashpad handler：独立进程负责捕获崩溃、生成 minidump。
; 必须与主程序同目录，CrashpadClient::StartHandler 按相对路径找它
#if HasCrashpadHandler == 1
Source: "{#WhereAreFiles}\crashpad_handler.exe"; DestDir: "{app}"; Flags: ignoreversion
#endif
Source: "{#WhereAreFiles}\Qt5*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#WhereAreFiles}\@ISCC_VC_REDIST@"; DestDir: "{app}"; Flags: ignoreversion

; Qt 运行时插件目录
; windeployqt 只部署程序实际用到的插件目录，故按依赖 Qt 模块而存在的
; 目录（sqldrivers 等）必须带 skipifsourcedoesntexist，否则打包直接报错
;Source: "{#WhereAreFiles}\bearer\*.dll"; DestDir: "{app}\bearer"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\iconengines\*.dll"; DestDir: "{app}\iconengines"; Flags: ignoreversion
Source: "{#WhereAreFiles}\imageformats\*.dll"; DestDir: "{app}\imageformats"; Flags: ignoreversion
Source: "{#WhereAreFiles}\platforms\*.dll"; DestDir: "{app}\platforms"; Flags: ignoreversion
Source: "{#WhereAreFiles}\styles\*.dll"; DestDir: "{app}\styles"; Flags: ignoreversion
Source: "{#WhereAreFiles}\sqldrivers\*.dll"; DestDir: "{app}\sqldrivers"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\translations\*.qm"; DestDir: "{app}\translations"; Flags: ignoreversion skipifsourcedoesntexist

; 配置 + 数据（模板示例，项目未必有这些目录）
Source: "{#WhereAreFiles}\config\*"; DestDir: "{app}\config"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "{#WhereAreFiles}\calibration\*"; DestDir: "{app}\calibration"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\@TARGET_NAME@.exe"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]

var
  DeleteUserData: Boolean;

// VC++ 运行库由 [Tasks] 的 installvcruntime 复选框控制。
// 该安装包需要管理员权限，故用 runas 触发 UAC 提权后静默安装；
// ewNoWait 表示不阻塞安装流程。
procedure CurStepChanged(CurStep: TSetupStep);
var
  ErrorCode: Integer;
  VcRedistPath: String;
begin
  if CurStep = ssPostInstall then
  begin
    if IsTaskSelected('installvcruntime') then
    begin
      VcRedistPath := ExpandConstant('{app}\@ISCC_VC_REDIST@');
      if FileExists(VcRedistPath) then
      begin
        ShellExec('runas', VcRedistPath,
                  '/install /quiet /norestart',
                  '', SW_SHOW, ewNoWait, ErrorCode);
      end;
    end;
  end;
end;

// 卸载前：主程序若在运行，先关闭再卸载
function InitializeUninstall(): Boolean;
var
  ErrorCode: Integer;
begin
  Result := True;

  if CheckForMutexes('{#MyAppMutex}') then
  begin
    if MsgBox('检测到 {#MyAppName} 正在运行，是否自动关闭后继续卸载？',
              mbConfirmation, MB_YESNO) = IDYES then
    begin
      Exec('taskkill.exe', '/f /t /im @TARGET_NAME@.exe', '',
           SW_HIDE, ewWaitUntilTerminated, ErrorCode);
    end
    else
    begin
      Result := False;
      Exit;
    end;
  end;
end;

// 把标准卸载进度页换成自定义页，放一个「删除用户数据」复选框。
// 结果存入 DeleteUserData，供 CurUninstallStepChanged 使用。
procedure InitializeUninstallProgressForm();
var
  UninstallPage: TNewNotebookPage;
  UninstallButton: TNewButton;
  CheckBox: TNewCheckBox;
  OriginalPageNameLabel: String;
  OriginalPageDescriptionLabel: String;
  OriginalCancelButtonEnabled: Boolean;
  OriginalCancelButtonModalResult: Integer;
  ctrl: TWinControl;
begin
  if UninstallSilent then
  begin
    DeleteUserData := False;
    Exit;
  end;

  ctrl := UninstallProgressForm.CancelButton;

  { 「卸载」按钮 }
  UninstallButton := TNewButton.Create(UninstallProgressForm);
  UninstallButton.Parent := UninstallProgressForm;
  UninstallButton.Left := ctrl.Left - ctrl.Width - ScaleX(10);
  UninstallButton.Top := ctrl.Top;
  UninstallButton.Width := ctrl.Width;
  UninstallButton.Height := ctrl.Height;
  UninstallButton.TabOrder := ctrl.TabOrder;
  UninstallButton.Caption := '卸载';
  UninstallButton.ModalResult := mrOk;
  UninstallButton.Default := True;
  UninstallProgressForm.CancelButton.TabOrder := UninstallButton.TabOrder + 1;

  { 把自定义页插入向导 }
  UninstallPage := TNewNotebookPage.Create(UninstallProgressForm);
  UninstallPage.Notebook := UninstallProgressForm.InnerNotebook;
  UninstallPage.Parent := UninstallProgressForm.InnerNotebook;
  UninstallPage.Align := alClient;
  UninstallProgressForm.InnerNotebook.ActivePage := UninstallPage;

  { 复选框：路径与运行时 QStandardPaths::AppLocalDataLocation 一致，
    由 CMake 的 APP_ORG_NAME / APP_APP_NAME 注入 }
  CheckBox := TNewCheckBox.Create(UninstallProgressForm);
  CheckBox.Parent := UninstallPage;
  CheckBox.Left := ScaleX(20);
  CheckBox.Top := ScaleY(40);
  CheckBox.Width := ScaleX(350);
  CheckBox.Height := ScaleY(17);
  CheckBox.Caption :=
      '删除用户配置和缓存数据（%LOCALAPPDATA%\@APP_ORG_NAME@\@APP_APP_NAME@）';
  CheckBox.Checked := False;

  { 保存原始状态 }
  OriginalPageNameLabel := UninstallProgressForm.PageNameLabel.Caption;
  OriginalPageDescriptionLabel :=
      UninstallProgressForm.PageDescriptionLabel.Caption;
  OriginalCancelButtonEnabled := UninstallProgressForm.CancelButton.Enabled;
  OriginalCancelButtonModalResult :=
      UninstallProgressForm.CancelButton.ModalResult;

  { 切换到自定义页 }
  UninstallProgressForm.PageNameLabel.Caption := '卸载选项';
  UninstallProgressForm.PageDescriptionLabel.Caption := '选择要移除的内容。';
  UninstallProgressForm.CancelButton.Enabled := True;
  UninstallProgressForm.CancelButton.ModalResult := mrCancel;

  if UninstallProgressForm.ShowModal = mrCancel then
    Abort;

  { 恢复标准布局 }
  UninstallButton.Visible := False;
  UninstallProgressForm.PageNameLabel.Caption := OriginalPageNameLabel;
  UninstallProgressForm.PageDescriptionLabel.Caption :=
      OriginalPageDescriptionLabel;
  UninstallProgressForm.CancelButton.Enabled := OriginalCancelButtonEnabled;
  UninstallProgressForm.CancelButton.ModalResult :=
      OriginalCancelButtonModalResult;

  { 回到标准卸载页 }
  UninstallProgressForm.InnerNotebook.ActivePage :=
      UninstallProgressForm.InstallingPage;

  DeleteUserData := CheckBox.Checked;
end;

// 卸载完成后按复选框决定是否删除用户数据
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    if DeleteUserData then
    begin
      Log('Deleting user data...');
      DelTree(ExpandConstant(
                  '{localappdata}\@APP_ORG_NAME@\@APP_APP_NAME@'),
              True, True, True);
      Log('User data deleted.');
    end;
  end;
end;

function InitializeSetup(): Boolean;
var
  ErrorCode: Integer;
begin
  if CheckForMutexes('{#MyAppMutex}') then
  begin
    if MsgBox('检测到 {#MyAppName} 正在运行，是否关闭后继续安装？',
              mbConfirmation, MB_YESNO) = IDYES then
    begin
      ShellExec('open', ExpandConstant('{cmd}'),
        '/c taskkill /f /t /im @TARGET_NAME@.exe', '',
        SW_HIDE, ewNoWait, ErrorCode);
      Result := True;
    end
    else
      Result := False;
  end
  else
    Result := True;
end;
