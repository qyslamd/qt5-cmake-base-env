@echo off
chcp 65001 >nul
rem funq - server side. This is the window you keep open.
rem
rem Starts the application with libFunQ injected (CreateRemoteThread +
rem LoadLibrary on Windows), then waits for a client to connect. Keep it open
rem while running funq-self-test.bat or your own client. Ctrl+C stops both.
rem
rem Everything is resolved relative to this script's own folder, so the product
rem can be installed anywhere. Generated by CMake - do not edit.

setlocal
set "FUNQ_DIR=%~dp0"
set "APP_EXE=%FUNQ_DIR%..\@TARGET_NAME@.exe"

rem Qt runtime: the application's own folder first, then the extra Qt modules the
rem injector needs but the application does not (collected into qt\ at build time -
rem windeployqt only knows what the application itself links). The tested program
rem inherits this PATH, which is how the injected library resolves its imports
set "PATH=%FUNQ_DIR%..;%FUNQ_DIR%qt;%PATH%"

rem No PYTHONPATH is set on purpose: the bundled interpreter takes funq's
rem packages from its own ._pth (see the python folder). Setting PYTHONPATH
rem here would be ignored - a ._pth without `import site` decides sys.path.

if not exist "%APP_EXE%" (
    echo Application not found: %APP_EXE%
    echo This script must stay next to the installed application.
    exit /b 1
)

rem With an existing instance the runner starts a process that gets swallowed by
rem the application's single instance check and then reports an error that does
rem not explain itself - say it clearly here instead
"%FUNQ_DIR%python\python.exe" "%FUNQ_DIR%check_no_instance.py" --name @APP_APP_NAME@
if errorlevel 1 (
    echo.
    echo Not started. Close the running @APP_APP_NAME@ and run this script again.
    exit /b 1
)

echo Starting @APP_APP_NAME@ with libFunQ injected on localhost:@FUNQ_DEMO_PORT@
echo Run funq-self-test.bat in another window to check it works. Ctrl+C to stop.
echo.

"%FUNQ_DIR%python\python.exe" -m funq_server.runner --port @FUNQ_DEMO_PORT@ --library "%FUNQ_DIR%server\funq_server\libFunQ.dll" "%APP_EXE%"
