@echo off
REM Auto-generated by CMake from cmake/template/clean_deps.bat.in - do not edit.
REM
REM Removes the third-party directories that extract_dependencies.cmake
REM unpacked into 3rdparty/. The archives themselves are kept: they are
REM version-controlled inputs, while the unpacked trees are reproducible
REM artifacts.
REM
REM NOTE: keep this file ASCII-only. cmd.exe decodes batch files with the
REM OEM codepage, so non-ASCII text gets torn apart and its fragments are
REM executed as commands. "chcp 65001" does not reliably fix this because
REM the parser has already decoded the line being executed.

setlocal

set "DEPS_ROOT=%~dp0..\3rdparty"
if not exist "%DEPS_ROOT%" (
    echo [ERROR] %DEPS_ROOT% not found.
    exit /b 1
)

echo Cleaning extracted dependencies under "%DEPS_ROOT%"...

for %%D in (
@CLEAN_DEPS_DIRS@) do (
    if exist "%DEPS_ROOT%\%%~D" (
        echo   Removing %%~D
        rmdir /s /q "%DEPS_ROOT%\%%~D"
    ) else (
        echo   Skip %%~D ^(not present^)
    )
)

echo Done.
endlocal