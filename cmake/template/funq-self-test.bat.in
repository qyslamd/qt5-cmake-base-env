@echo off
chcp 65001 >nul
rem funq - self test. This is the client side.
rem
rem Connects to the funq-server window over TCP, drives the running
rem application through a few steps and prints what it sees at each step.
rem It starts no program and needs no Qt paths - that is the whole point of
rem funq's split: the client only knows host:port.
rem
rem Run funq-server.bat first and keep that window open.
rem Generated by CMake - do not edit. Extra arguments are passed through
rem (see --help of the script, e.g. --dwell 0 to turn the demo pauses off).

setlocal
set "FUNQ_DIR=%~dp0"
"%FUNQ_DIR%python\python.exe" "%FUNQ_DIR%funq_client_demo.py" --port @FUNQ_DEMO_PORT@ %*
