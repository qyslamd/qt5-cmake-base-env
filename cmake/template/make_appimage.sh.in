#!/bin/bash
# AppImage packaging script: generated by CMake configure_file, do not edit.
# Template: cmake/make_appimage.sh.in. Windows counterpart: scripts/make_installer.bat.
#
# Steps:
#   1. Check the build configuration (Debug is rejected for packaging; shares
#      the same check script as the Windows side)
#   2. Lay out the AppDir: cmake --install into usr/bin, with config and data
#      directories placed next to the executable, the same layout as Windows
#   3. linuxdeploy collects dependencies; its qt plugin bundles the Qt
#      libraries, platform plugins and translations
#   4. strip the executable inside the AppDir, then let appimagetool produce
#      the .AppImage
#   5. Archive the unstripped executable: crash logs only carry raw addresses,
#      and resolving them with addr2line later requires the unstripped binary
#      that matches the packaged one - the counterpart of Windows symbol
#      archiving
#
# The three packaging tools and the type2 runtime ship with the repository
# (3rdparty/appimage-tools/), so no network access is needed. The script
# exports APPIMAGE_EXTRACT_AND_RUN so the tools self-extract without FUSE,
# which also works in containers and CI.
#
# Before step 1 there is one more check: this script is generated into the
# SOURCE TREE, and the build directories of one source tree (debug /
# relwithdebinfo / release) share that single file - whichever was configured
# last overwrites the others. Running make_appimage from an older build
# directory would then execute someone else's script: at best the binary is
# missing, at worst the Debug packaging rejection is bypassed. The caller is
# therefore required to pass the build directory, and a mismatch against the
# path baked into the script exits immediately (exit code 2), mirroring the
# EXPECTED_BIN check in make_installer.bat on Windows.
#
# Usage:
#   make_appimage.sh <directory containing the executable>   # passed by the make_appimage target
#   (pass it when calling directly too, otherwise there is nothing to compare)
#
# Qt is injected at configure time from the located qmake (the same Qt the
# project links against); to use another Qt, export QMAKE to override:
#   QMAKE=/opt/Qt/5.15.2/gcc_64/bin/qmake ./scripts/make_appimage.sh <bin dir>

set -euo pipefail

APP_NAME="@APP_APP_NAME@"
APP_VERSION="@APP_VERSION@"
TARGET_NAME="@TARGET_NAME@"
APPIMAGE_ARCH="@APPIMAGE_ARCH@"
BUILD_DIR="@APPIMAGE_BUILD_DIR@"
OUTPUT_DIR="@APPIMAGE_OUTPUT_DIR@"
TOOLS_DIR="@APPIMAGE_TOOLS_DIR@"
WORK_DIR="@APPIMAGE_WORK_DIR@"
DESKTOP_SRC="@APPIMAGE_DESKTOP_FILE@"
ICON_SRC="@APPIMAGE_ICON_FILE@"
SYMBOLS_DIR="@APPIMAGE_SYMBOLS_DIR@"
BUILD_TYPE="@CMAKE_BUILD_TYPE@"
CHECK_SCRIPT="@APPIMAGE_CHECK_SCRIPT@"
QT_QMAKE="@QT_QMAKE_EXECUTABLE@"
CMAKE="@CMAKE_COMMAND@"

APP_DIR="$WORK_DIR/${APP_NAME}.AppDir"
BIN_DIR="$BUILD_DIR/bin"
EXE_NAME="${TARGET_NAME}"
# The tool architecture suffix comes from APPIMAGE_ARCH: the repository ships
# one set of tools for exactly that architecture
TOOL_SUFFIX="$APPIMAGE_ARCH"
# The type2 runtime appimagetool embeds into the AppImage, also shipped in-repo
RUNTIME_FILE="$TOOLS_DIR/runtime-${TOOL_SUFFIX}"

die() {
    echo "error: $*" >&2
    exit 1
}

# ---- 0. Check that the script matches the build directory (see header; same exit code 2 as Windows) ----
# ${1:-} instead of $1: with set -u an unset $1 aborts outright, and what we
# want here is a readable message
if [ "${1:-}" != "$BIN_DIR" ]; then
    echo "error: packaging script does not match the current build directory." >&2
    echo "  build directory baked into the script: $BIN_DIR" >&2
    echo "  passed in this time: ${1:-(not passed)}" >&2
    echo "  the script is generated into the source tree and shared by all build" >&2
    echo "  directories; whichever was configured last overwrites the others." >&2
    echo "  Re-run configure for the current build directory and retry, e.g.:" >&2
    echo "    ./scripts/build_ninja.sh -t relwithdebinfo -p" >&2
    exit 2
fi

# ---- 1. Build configuration check (same script as the make_appimage target, so direct calls are caught too) ----
"$CMAKE" -DBUILD_TYPE="$BUILD_TYPE" -DPLATFORM=LINUX -P "$CHECK_SCRIPT"

# ---- 2. Preflight: say exactly what is missing instead of leaving a half-built artifact ----
[ -x "$BIN_DIR/$EXE_NAME" ] || die "not found: $BIN_DIR/$EXE_NAME - build first"
[ -f "$ICON_SRC" ] || die "missing icon $ICON_SRC (AppImage needs a 256x256 PNG)"
[ -f "$DESKTOP_SRC" ] || die "missing $DESKTOP_SRC - re-run configure to generate it"
command -v strip >/dev/null || die "missing strip (binutils), cannot trim the release binary"

for tool in linuxdeploy linuxdeploy-plugin-qt appimagetool; do
    tool_path="$TOOLS_DIR/${tool}-${TOOL_SUFFIX}.AppImage"
    if [ ! -f "$tool_path" ]; then
        die "missing $tool_path (packaging tools ship with the repository, see
3rdparty/appimage-tools/README.md; if the target architecture is not
${TOOL_SUFFIX}, you need to provide that set of tools yourself)"
    fi
    # Cloning on Windows can lose the permission bits; restore them
    chmod +x "$tool_path" 2>/dev/null || true
done

# type2 runtime: appimagetool must embed it into the AppImage. Without
# --runtime-file it fetches the file from GitHub's release CDN, which is often
# unreachable from China - and that download has no timeout, so a stuck process
# sits at 0% CPU looking like it is compressing when it is really just waiting.
# Hence it ships in-repo along with the three tools
[ -f "$RUNTIME_FILE" ] || die "missing $RUNTIME_FILE (the type2 runtime ships with
the repository, see 3rdparty/appimage-tools/README.md)"

# ---- 3. Lay out the AppDir ----
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/usr"
"$CMAKE" --install "$BUILD_DIR" --prefix "$APP_DIR/usr" >/dev/null

# Config and data directories: template examples a project may not have; placed
# next to the executable as on Windows
for data_dir in config calibration; do
    if [ -e "$BIN_DIR/$data_dir" ]; then
        cp -a "$BIN_DIR/$data_dir" "$APP_DIR/usr/bin/"
    fi
done

# ---- 4. linuxdeploy: collect dependencies + let the qt plugin bundle Qt ----
# APPIMAGE_EXTRACT_AND_RUN lets the tools self-extract without FUSE; QMAKE
# defaults to the one located at configure time so the bundled Qt is the same
# one the project links against
export APPIMAGE_EXTRACT_AND_RUN=1
if [ -n "$QT_QMAKE" ]; then
    export QMAKE="${QMAKE:-$QT_QMAKE}"
fi

# The plugin must appear on PATH as linuxdeploy-plugin-qt for linuxdeploy to find it
PLUGIN_DIR="$WORK_DIR/tools"
mkdir -p "$PLUGIN_DIR"
ln -sf "$TOOLS_DIR/linuxdeploy-plugin-qt-${TOOL_SUFFIX}.AppImage" \
       "$PLUGIN_DIR/linuxdeploy-plugin-qt"

# Pass source files for the .desktop and the icon; linuxdeploy places them at
# the AppDir root. --icon-filename makes the installed icon name match the
# Icon= entry in the .desktop file (the source file is icon.png while Icon=
# uses the application name - a mismatch means the icon is not found)
PATH="$PLUGIN_DIR:$PATH" "$TOOLS_DIR/linuxdeploy-${TOOL_SUFFIX}.AppImage" \
    --appdir "$APP_DIR" \
    --desktop-file "$DESKTOP_SRC" \
    --icon-file "$ICON_SRC" \
    --icon-filename "$APP_NAME" \
    --plugin qt

# ---- 5. Trim + package ----
strip --strip-unneeded "$APP_DIR/usr/bin/$EXE_NAME"

mkdir -p "$OUTPUT_DIR"
APPIMAGE_FILE="$OUTPUT_DIR/${APP_NAME}-${APPIMAGE_ARCH}-${APP_VERSION}.AppImage"
ARCH="$APPIMAGE_ARCH" VERSION="$APP_VERSION" \
    "$TOOLS_DIR/appimagetool-${TOOL_SUFFIX}.AppImage" -n \
    --runtime-file "$RUNTIME_FILE" \
    "$APP_DIR" "$APPIMAGE_FILE"

# ---- 6. Archive the unstripped executable (Windows handles this in the make_symbols target) ----
mkdir -p "$SYMBOLS_DIR"
cp "$BIN_DIR/$EXE_NAME" "$SYMBOLS_DIR/"

echo
echo "AppImage created: $APPIMAGE_FILE"
echo "Symbols archived: $SYMBOLS_DIR/$EXE_NAME"
echo "  Resolve raw addresses from crash logs with: addr2line -e $SYMBOLS_DIR/$EXE_NAME -f -C <address>"
