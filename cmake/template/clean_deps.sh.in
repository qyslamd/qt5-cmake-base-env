#!/bin/bash
# Auto-generated by CMake from cmake/template/clean_deps.sh.in - do not edit.
#
# 删除 extract_dependencies.cmake 解压到 3rdparty/ 下的第三方目录。
# 压缩包本身保留：它们是版本受控的输入，解压产物才是可重建的中间物。

set -euo pipefail

DEPS_ROOT="$(cd "$(dirname "$0")/.." && pwd)/3rdparty"
if [ ! -d "$DEPS_ROOT" ]; then
    echo "error: $DEPS_ROOT not found" >&2
    exit 1
fi

echo "Cleaning extracted dependencies under $DEPS_ROOT..."

dirs=(
@CLEAN_DEPS_DIRS@)

for dir in "${dirs[@]}"; do
    if [ -d "$DEPS_ROOT/$dir" ]; then
        echo "  Removing $dir"
        rm -rf -- "$DEPS_ROOT/$dir"
    else
        echo "  Skip $dir (not present)"
    fi
done

echo "Done."