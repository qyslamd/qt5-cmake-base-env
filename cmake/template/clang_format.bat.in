@echo off
REM Auto-generated by CMake - do not edit
REM
REM Launcher for clang_format.ps1. All arguments are passed through:
REM   clang_format.bat                  format the C/C++ files git reports as changed
REM   clang_format.bat -All             format every C/C++ file in the tree
REM   clang_format.bat -Files src\app\main.cpp
REM   clang_format.bat -Check           change nothing, exit 1 if a file is off
REM
REM Uses the built-in Windows PowerShell, which is present on every Windows
REM install; nothing extra needs to be installed. The script is written to
REM run under pwsh too, but does not require it.
REM
REM NOTE: keep this file ASCII-only. cmd.exe decodes batch files with the OEM
REM codepage, so non-ASCII text would be torn apart and its fragments
REM executed as commands.

setlocal

set "SCRIPT=%~dp0clang_format.ps1"
if not exist "%SCRIPT%" (
    echo Error: %SCRIPT% not found.
    echo Re-run CMake configure to regenerate it.
    exit /b 1
)

where powershell >nul 2>&1
if errorlevel 1 (
    echo Error: powershell not found on PATH.
    exit /b 1
)

powershell -NoProfile -ExecutionPolicy Bypass -File "%SCRIPT%" %*
exit /b %errorlevel%
