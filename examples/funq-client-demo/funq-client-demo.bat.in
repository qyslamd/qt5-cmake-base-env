@echo off
chcp 65001 >nul
rem Terminal 2 - the client side.
rem
rem Connects over TCP and only sends messages: it starts no program and needs
rem no Qt DLL paths. That is the "separation" - the client knows nothing about
rem the tested program beyond host:port.
rem
rem Generated by CMake into <build>/bin, not tracked in git.

set "PYTHONPATH=@FUNQ_CLIENT_DIR@;%PYTHONPATH%"

"@PYTHON_EXECUTABLE@" "@DEMO_CLIENT_PY@" --port @FUNQ_DEMO_PORT@
