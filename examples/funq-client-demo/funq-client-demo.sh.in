#!/bin/sh
# Terminal 2 - the client side (Linux counterpart of funq-client-demo.bat).
#
# Connects over TCP and only sends messages: it starts no program and needs no
# Qt library paths. That is the "separation" - the client knows nothing about
# the tested program beyond host:port.
#
# Generated by CMake into <build>/bin, not tracked in git.

PYTHONPATH="@FUNQ_CLIENT_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "@PYTHON_EXECUTABLE@" "@DEMO_CLIENT_PY@" --port @FUNQ_DEMO_PORT@
