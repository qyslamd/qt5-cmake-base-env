#!/bin/sh
# Terminal 1 - the server side (Linux counterpart of funq-server-demo.bat).
#
# Starts demo_app with libFunq injected. Linux goes through LD_PRELOAD: the
# library is put into the environment first and the tested program is then
# exec'd, so the library constructor runs along with the program - the reverse
# order of Windows (which starts the program first and injects the DLL later).
#
# This terminal stays occupied: the runner waits for the tested program until
# it exits. Ctrl+C stops both.
#
# Generated by CMake into <build>/bin, not tracked in git.

PYTHONPATH="@FUNQ_CLIENT_DIR@:@FUNQ_SERVER_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# Make sure the tested program is not already running. The Linux runner does
# not even check liveness: with an existing instance it quietly reports
# success, saying nothing - say it clearly here instead
if ! "@PYTHON_EXECUTABLE@" "@INSTANCE_PROBE_PY@" --name @APP_APP_NAME@; then
    echo
    echo "Not started. Close the running demo_app and run this script again."
    exit 1
fi

echo "demo_app is about to start with libFunq injected on localhost:@FUNQ_DEMO_PORT@"
echo "Run funq-client-demo in another terminal to connect. Ctrl+C to stop."
echo

# --library names the injector built for THIS build directory (the staging
# directory lives in the source tree and is shared by every configuration, so
# a library whose configuration differs from the tested program only reports a
# message that does not explain itself)
exec "@PYTHON_EXECUTABLE@" -m funq_server.runner --port @FUNQ_DEMO_PORT@ --library "@FUNQ_INJECTOR_LIBRARY@" "@DEMO_APP_EXE@"
