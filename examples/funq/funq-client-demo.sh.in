#!/bin/sh
# 终端 2 —— client 侧（Linux 对应 funq-client-demo.bat）。
#
# 只连 TCP、只发消息，不启动任何程序、也不需要 Qt 的库路径。
# 这就是「分离」：client 侧对被测程序一无所知，只有 host:port。
#
# 本文件由 CMake 生成到 <构建目录>/bin，不入库。

PYTHONPATH="@FUNQ_CLIENT_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "@PYTHON_EXECUTABLE@" "@DEMO_CLIENT_PY@" --port @FUNQ_DEMO_PORT@
