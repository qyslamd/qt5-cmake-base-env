#!/bin/sh
# 终端 1 —— server 侧（Linux 对应 serve_demo_app.bat）。
#
# 起 demo_app 并注入 libFunq。Linux 走 LD_PRELOAD：先把库挂进环境变量，
# 再 exec 被测程序，库的构造器随程序一起加载——顺序与 Windows 相反
# （Windows 是先把程序跑起来、再远程把 DLL 塞进去）。
#
# 这个终端会被占住：runner 启动完被测程序就一直 wait 着它。Ctrl+C 结束，
# 被测程序也跟着结束。
#
# 本文件由 CMake 生成到构建目录，不入库。

PYTHONPATH="@FUNQ_CLIENT_DIR@:@FUNQ_SERVER_DIR@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# 先确认被测程序没在跑。Linux 侧的 runner 连存活检查都没有，已有实例时会
# 静默地"成功"返回，什么提示都没有——这里提前把话说清楚
if ! "@PYTHON_EXECUTABLE@" "@INSTANCE_PROBE_PY@" --name @APP_APP_NAME@; then
    echo
    echo "未启动。关掉正在运行的 demo_app 后重跑本脚本。"
    exit 1
fi

echo "demo_app 即将启动并被注入，libFunq 监听 localhost:@FUNQ_DEMO_PORT@"
echo "另一个终端跑 run_demo_client 接上它。Ctrl+C 结束。"
echo

exec "@PYTHON_EXECUTABLE@" -m funq_server.runner --port @FUNQ_DEMO_PORT@ "@DEMO_APP_EXE@"
