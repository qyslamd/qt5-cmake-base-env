@echo off
chcp 65001 >nul
rem Terminal 1 - the server side.
rem
rem Starts demo_app with libFunq injected (Windows uses CreateRemoteThread +
rem LoadLibrary); libFunq then opens a TCP service inside the tested process
rem and waits for a client to connect.
rem
rem This window stays occupied: the runner waits for the tested program until
rem it exits. Ctrl+C stops both.
rem
rem Generated by CMake into <build>/bin, not tracked in git.

set "PATH=@QT_BIN_DIR@;%PATH%"
set "PYTHONPATH=@FUNQ_CLIENT_DIR@;@FUNQ_SERVER_DIR@;%PYTHONPATH%"

rem Make sure the tested program is not already running. With an existing
rem instance the runner starts a process that is swallowed by the single
rem instance check and then reports an error that does not explain itself -
rem say it clearly here instead
"@PYTHON_EXECUTABLE@" "@INSTANCE_PROBE_PY@" --name @APP_APP_NAME@
if errorlevel 1 (
    echo.
    echo Not started. Close the running demo_app and run this script again.
    exit /b 1
)

echo demo_app is about to start with libFunq injected on localhost:@FUNQ_DEMO_PORT@
echo Run funq-client-demo in another terminal to connect. Ctrl+C to stop.
echo.

rem --library names the injector built for THIS build directory (the staging
rem directory lives in the source tree and is shared by every configuration,
rem so a library whose configuration differs from the tested program only
rem reports a message that does not explain itself)
"@PYTHON_EXECUTABLE@" -m funq_server.runner --port @FUNQ_DEMO_PORT@ --library "@FUNQ_INJECTOR_LIBRARY@" "@DEMO_APP_EXE@"
