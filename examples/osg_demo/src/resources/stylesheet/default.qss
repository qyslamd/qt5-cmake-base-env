/* OSG Viewer 浅色主题
 * 白色面板 + 浅灰窗口底，强调色用于选中与聚焦状态。 */

QMainWindow,
QDialog {
    background-color: #f2f4f7;
    color: #24292f;
}

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QLabel {
    color: #24292f;
    background: transparent;
}

/* ---------- 工具栏 ---------- */

QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #dde1e7;
    spacing: 2px;
    padding: 3px 8px;
}

QToolBar QToolButton {
    background: transparent;
    color: #24292f;
    padding: 4px 9px;
    border-radius: 4px;
}

QToolBar QToolButton:hover {
    background-color: #eceff3;
}

QToolBar QToolButton:pressed {
    background-color: #dbe6f6;
}

QToolBar QToolButton:checked {
    background-color: #dbe6f6;
    color: #0b57d0;
}

QToolBar::separator {
    background-color: #dde1e7;
    width: 1px;
    margin: 4px 6px;
}

/* ---------- 停靠面板 ---------- */

QDockWidget {
    color: #24292f;
}

QDockWidget::title {
    background-color: #ffffff;
    color: #24292f;
    font-weight: 600;
    padding: 6px 10px;
    border-bottom: 1px solid #dde1e7;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #eceff3;
    border-radius: 3px;
}

/* ---------- 下拉框 ---------- */

QComboBox {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #cfd5dd;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 16px;
}

QComboBox:hover {
    border-color: #2f6fd0;
}

QComboBox:focus {
    border-color: #2f6fd0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #cfd5dd;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
    outline: none;
}

/* ---------- 组件列表 ---------- */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #dde1e7;
    border-radius: 4px;
    padding: 4px;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #eceff3;
}

QListWidget::item:selected {
    background-color: #2f6fd0;
    color: #ffffff;
}

/* ---------- 日志 ---------- */

QPlainTextEdit {
    background-color: #fbfcfd;
    color: #3a3f45;
    border: 1px solid #dde1e7;
    border-radius: 4px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
}

/* ---------- 复选框 ---------- */

QCheckBox {
    color: #4a515a;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #b9c0ca;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #2f6fd0;
}

QCheckBox::indicator:checked {
    background-color: #2f6fd0;
    border-color: #2f6fd0;
}

/* ---------- 状态栏 ---------- */

QStatusBar {
    background-color: #f0f2f5;
    color: #6e7781;
    border-top: 1px solid #dde1e7;
}

QStatusBar::item {
    border: none;
}

/* ---------- 滚动条 ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #c3c9d2;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a8b0bb;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #c3c9d2;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a8b0bb;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---------- 提示与消息框 ---------- */

QToolTip {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #cfd5dd;
    padding: 4px 6px;
}

QMessageBox {
    background-color: #f2f4f7;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #cfd5dd;
    border-radius: 4px;
    padding: 5px 16px;
    min-width: 64px;
}

QMessageBox QPushButton:hover {
    border-color: #2f6fd0;
}

QMessageBox QPushButton:pressed {
    background-color: #dbe6f6;
}

/* ---------- 3D 注释气泡 ---------- */

QLabel[role="annotation"] {
    background-color: rgba(15, 20, 28, 200);
    color: #f0f0f5;
    border: 1px solid rgba(255, 220, 70, 200);
    border-radius: 4px;
    padding: 4px 8px;
    font: 12px "Microsoft YaHei";
}

QLabel[role="annotation"]:hover {
    background-color: rgba(30, 40, 55, 230);
    border-color: rgb(255, 235, 130);
}
