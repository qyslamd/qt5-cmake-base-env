@echo off
setlocal

REM Auto-generated by CMake from examples/md_viewer/make_win_install.bat.in.
REM Usage: make_win_install.bat
REM Build the md_viewer target first. This script runs windeployqt, then ISCC.
REM Keep this file ASCII-only: cmd.exe decodes .bat files with the OEM codepage.

set "BIN_DIR=@MD_VIEWER_WHERE_ARE_FILES@"
set "EXE=%BIN_DIR%\@TARGET_NAME@.exe"
set "WINDEPLOYQT=@MD_VIEWER_WINDEPLOYQT@"
set "ISCC=@MD_VIEWER_ISCC@"
set "ISS=@MD_VIEWER_ISS_FILE@"

if not exist "%EXE%" (
    echo [ERROR] %EXE% not found. Build the @TARGET_NAME@ target first.
    exit /b 2
)
if exist "%BIN_DIR%\Qt5Cored.dll" (
    echo [ERROR] Debug build detected. Package a relwithdebinfo build instead.
    exit /b 2
)
if not exist "%BIN_DIR%\FluentUI3Style.dll" (
    echo [ERROR] FluentUI3Style.dll not found next to the exe.
    exit /b 2
)
if not exist "%WINDEPLOYQT%" (
    echo [ERROR] windeployqt not found: %WINDEPLOYQT%
    exit /b 2
)
if not exist "%ISCC%" (
    echo [ERROR] ISCC not found: %ISCC%
    exit /b 2
)

echo Deploying Qt runtime for @TARGET_NAME@...
"%WINDEPLOYQT%" --verbose 1 --no-angle --no-opengl-sw --no-system-d3d-compiler --compiler-runtime "%EXE%"
if errorlevel 1 (
    echo [ERROR] windeployqt failed.
    exit /b 1
)

echo Building installer with Inno Setup...
"%ISCC%" /Qp "%ISS%"
if errorlevel 1 (
    echo [ERROR] ISCC failed.
    exit /b 1
)

echo Package created in @MD_VIEWER_PACKAGE_OUTPUT_DIR@
