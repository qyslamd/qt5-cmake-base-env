; Generated by CMake from examples/md_viewer/md_viewer.iss.in
; Standalone Inno Setup script for md_viewer. The project information below is
; defined in examples/md_viewer/CMakeLists.txt, not in the top-level CMakeLists.

#define WhereAreFiles "@MD_VIEWER_WHERE_ARE_FILES@"
#define MyAppName "@MD_VIEWER_PACKAGE_NAME@"
#define MyAppPublisher "@MD_VIEWER_PACKAGE_PUBLISHER@"
#define MyAppURL "@MD_VIEWER_PACKAGE_URL@"
#define MyInstallerIcon "@MD_VIEWER_ICON_ICO@"
#define MyVcRedist "@MD_VIEWER_VC_REDIST@"

[Setup]
AppId=@MD_VIEWER_APP_ID@
AppName={#MyAppName}
AppVersion=@MD_VIEWER_VERSION@
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
#if "@MD_VIEWER_USE_64BIT@" == "YES"
ArchitecturesInstallIn64BitMode=x64compatible
#endif
OutputDir=@MD_VIEWER_PACKAGE_OUTPUT_DIR@
OutputBaseFilename=md_viewer-setup-@MD_VIEWER_ARCH_SUFFIX@-@MD_VIEWER_VERSION@
Compression=lzma
SolidCompression=yes
WizardStyle=modern
SetupIconFile={#MyInstallerIcon}
UninstallDisplayIcon={app}\@TARGET_NAME@.exe
Uninstallable=yes
UninstallDisplayName={#MyAppName}
CloseApplications=yes

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone

[Files]
Source: "{#WhereAreFiles}\@TARGET_NAME@.exe"; DestDir: "{app}"; Flags: ignoreversion
; FluentUI3Style is a project DLL, windeployqt only collects Qt's own files
Source: "{#WhereAreFiles}\FluentUI3Style.dll"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\Qt5*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#WhereAreFiles}\{#MyVcRedist}"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\platforms\*.dll"; DestDir: "{app}\platforms"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\imageformats\*.dll"; DestDir: "{app}\imageformats"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\iconengines\*.dll"; DestDir: "{app}\iconengines"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#WhereAreFiles}\styles\*.dll"; DestDir: "{app}\styles"; Flags: ignoreversion skipifsourcedoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\@TARGET_NAME@.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyVcRedist}"; Parameters: "/install /quiet /norestart"; StatusMsg: "正在安装 VC++ 运行库..."; Flags: runascurrentuser waituntilterminated; Check: VcRedistExists
Filename: "{app}\@TARGET_NAME@.exe"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; md_viewer.ini lives next to the exe and is created at runtime, so the
; uninstaller has to remove it explicitly.
Type: files; Name: "{app}\md_viewer.ini"

[Code]
function VcRedistExists: Boolean;
begin
  Result := FileExists(ExpandConstant('{app}\{#MyVcRedist}'));
end;

